e=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="45" y="1204" width="150" height="282" as="geometry"/></mxCell><mxCell id="p2-a39" value="⑰ network_settings.get() [C2]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="306" y="1235" as="sourcePoint"/><mxPoint x="524" y="1235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-a40" value="⑱ EIF_GetInfo(EIF_INFO_NETWORK_SETTINGS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="536" y="1273" as="sourcePoint"/><mxPoint x="754" y="1273" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-a41" value="⑲ RIM_GetBinary ×3（InfoMapのsource）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="766" y="1311" as="sourcePoint"/><mxPoint x="1444" y="1311" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-a42" value="⑳ convert()：RIM_network_info_t → 公開モデル" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#996600;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="766" y="1349" as="sourcePoint"/><mxPoint x="984" y="1349" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-a43" value="EIF_OK＋公開モデル" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;dashed=1;endArrow=open;endFill=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="754" y="1387" as="sourcePoint"/><mxPoint x="536" y="1387" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-a44" value="UC_OK＋network_settings_t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;dashed=1;endArrow=open;endFill=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="524" y="1425" as="sourcePoint"/><mxPoint x="306" y="1425" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-a45" value="&lt;b&gt;コールバックの制約（公開仕様に明記）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;[C2] RESTコールバック&lt;/b&gt;&lt;br&gt;複数スレッドから同時に呼ばれる。EIFの共有状態（相関表）はmutexで保護。&lt;br&gt;&lt;br&gt;&lt;b&gt;[C3] PCL完了callback&lt;/b&gt;&lt;br&gt;・PCL要求処理contextから直列に呼ばれる&lt;br&gt;・中からPCLの同期API（Submit等）へ再入禁止&lt;br&gt;・長時間ブロック禁止&lt;br&gt;・利用者contextが無い→generation IDで相関&lt;br&gt;・Submitの戻りより先に届く可能性→「先着完了」を保持&lt;br&gt;&lt;br&gt;&lt;b&gt;[C4] RIM通知callback&lt;/b&gt;&lt;br&gt;・RIM通知ワーカーから呼ばれる&lt;br&gt;・長時間ブロック禁止&lt;br&gt;・通知メッセージは呼出し中のみ有効&lt;br&gt;&lt;br&gt;&lt;b&gt;通知先（on_event）&lt;/b&gt;&lt;br&gt;・C3/C4 から呼ばれる&lt;br&gt;・ブロック禁止、EIF要求系APIの呼出し禁止&lt;br&gt;・server_ws_emit_event はコピーして即復帰するので適合&lt;br&gt;&lt;br&gt;&lt;b&gt;mutexの原則&lt;/b&gt;&lt;br&gt;PCL/REF呼出し中・通知先呼出し中はEIFのmutexを保持しない（デッドロック防止）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#333333;spacing=8;" vertex="1" parent="1"><mxGeometry x="1640" y="60" width="360" height="560" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.現行実装の課題" id="p3"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3-a1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;現行実装（