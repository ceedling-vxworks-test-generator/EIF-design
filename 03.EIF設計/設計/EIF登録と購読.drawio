<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" pages="3"><diagram name="1.2つの登録の違い" id="c1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;Connector登録と購読登録の違い&lt;/b&gt;&lt;/font&gt;　　Connector登録＝「誰に届けるか」をEIFに登録（Connectorごと）。購読登録＝「何を受け取るか」をRIMに登録（公開イベントごと、全体で1回）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="c1-2" value="① Connector登録：EIF_RegisterConnector()　… 届け先の登録" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=16;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1040" height="500" as="geometry"/></mxCell><mxCell id="c1-3" value="呼ぶ人：各Connector（起動時、EIF_Start より前に1回ずつ）&lt;br&gt;登録先：&lt;b&gt;Frameの中だけ&lt;/b&gt;（RIMは呼ばない）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="640" height="44" as="geometry"/></mxCell><mxCell id="c1-4" value="&lt;b&gt;Connector A&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;APIサーバー用&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;on_request_completed＝A_done&lt;br&gt;on_event＝A_event&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="220" height="90" as="geometry"/></mxCell><mxCell id="c1-5" value="&lt;b&gt;Connector B&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;PCインタフェース用（例）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;on_request_completed＝B_done&lt;br&gt;on_event＝B_event&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="220" height="90" as="geometry"/></mxCell><mxCell id="c1-6" value="&lt;b&gt;Frame&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;ConnectorRegistry&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;登録内容をコピーし、&lt;br&gt;event_filter をビット列にする&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="230" width="220" height="120" as="geometry"/></mxCell><mxCell id="c1-7" value="&lt;b&gt;Connector登録表（Frame）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;table style=&#x27;border-collapse:collapse;margin-top:4px;&#x27;&gt;&lt;tr&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;ID&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;callback&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;event_mask&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;1&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;A_done／A_event&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;ERROR_RAISED・RESOLVED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;2&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;B_done／B_event&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;ERROR_RAISED&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="180" width="330" height="230" as="geometry"/></mxCell><mxCell id="c1-8" value="EIF_RegisterConnector(&amp;descA)" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c1-4" target="c1-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-9" value="EIF_RegisterConnector(&amp;descB)" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c1-5" target="c1-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-10" value="書き込む" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;dashPattern=1 3;strokeColor=#64748B;" edge="1" parent="1" source="c1-6" target="c1-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-11" value="・中身は&lt;b&gt;届け先&lt;/b&gt;（callbackと、受け取りたい公開イベント）&lt;br&gt;・Connectorの数だけ行が増える（最大4）&lt;br&gt;・EIF_Start 以降は変更しない（ロックなしで読む）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="640" height="70" as="geometry"/></mxCell><mxCell id="c1-12" value="② 購読登録：EIF_Start()　… 情報源の登録" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=16;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="70" width="1260" height="500" as="geometry"/></mxCell><mxCell id="c1-13" value="呼ぶ人：起動処理（全Connectorの登録が終わった後に1回）&lt;br&gt;登録先：&lt;b&gt;RIM&lt;/b&gt;（と、REF Accessorの監視の登録表）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="110" width="700" height="44" as="geometry"/></mxCell><mxCell id="c1-14" value="&lt;b&gt;起動処理&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="180" width="150" height="70" as="geometry"/></mxCell><mxCell id="c1-15" value="&lt;b&gt;Frame&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;Watcher&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;公開イベントIDを順に見て、&lt;br&gt;機種が通知するものだけ依頼&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="340" width="200" height="110" as="geometry"/></mxCell><mxCell id="c1-16" value="&lt;b&gt;REF Accessor&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;watch_event()&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;イベントの対応表で&lt;br&gt;購読するREFの通知を引く&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1460" y="340" width="210" height="110" as="geometry"/></mxCell><mxCell id="c1-17" value="&lt;b&gt;g_ref_event_map&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;公開イベントID → REFの通知（機種ごと。名前は仮）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1460" y="180" width="210" height="80" as="geometry"/></mxCell><mxCell id="c1-18" value="&lt;b&gt;監視の登録表（REF Accessor）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;table style=&#x27;border-collapse:collapse;margin-top:4px;&#x27;&gt;&lt;tr&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;購読ID&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;公開イベント&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;Frameの受け口&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;101&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;ERROR_RAISED&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;on_info_event&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;102&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;ERROR_RESOLVED&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;on_info_event&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1740" y="170" width="300" height="130" as="geometry"/></mxCell><mxCell id="c1-19" value="&lt;b&gt;RIM（REF）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;RIM_Subscribe()&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;購読ID・対象の通知・通知契機・&lt;br&gt;呼ぶ関数（on_ref_notified）を記録&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2070" y="340" width="280" height="110" as="geometry"/></mxCell><mxCell id="c1-20" value="EIF_Start()" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c1-14" target="c1-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-21" value="watch_event()" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c1-15" target="c1-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-22" value="引く" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;dashPattern=1 3;strokeColor=#64748B;" edge="1" parent="1" source="c1-16" target="c1-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-23" value="RIM_Subscribe(…)" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="c1-16" target="c1-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-24" value="購読ID" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#475569;strokeWidth=1.2;fontColor=#334155;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.3;entryX=1;entryY=0.3;" edge="1" parent="1" source="c1-19" target="c1-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-25" value="書き込む" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;dashPattern=1 3;strokeColor=#64748B;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.8;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="c1-16" target="c1-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-26" value="・中身は&lt;b&gt;情報源&lt;/b&gt;（RIMのどの通知を、どの公開イベントとして受けるか）&lt;br&gt;・&lt;b&gt;公開イベントごとに1回&lt;/b&gt;。Connectorの数とは関係ない&lt;br&gt;・RIMに解除APIが無いため、取り消せない" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="480" width="760" height="70" as="geometry"/></mxCell><mxCell id="c1-27" value="③ 通知が来たとき：②で受け取り、①で配り分ける（購読1回 → 2つのConnectorへ）" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=16;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="2340" height="360" as="geometry"/></mxCell><mxCell id="c1-28" value="&lt;b&gt;RIM（REF）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;通知ワーカー&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;エラー発生（1件）&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2080" y="700" width="270" height="90" as="geometry"/></mxCell><mxCell id="c1-29" value="&lt;b&gt;REF Accessor&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;on_ref_notified(購読ID)&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;②の監視の登録表で購読ID→受け口を引き、&lt;br&gt;通知を EIF_Event に変換&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1640" y="690" width="300" height="110" as="geometry"/></mxCell><mxCell id="c1-30" value="&lt;b&gt;Frame&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;Watcher → EventDispatcher&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;①のConnector登録表の event_mask を&lt;br&gt;見て、一致したConnectorへ登録順に配る&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1180" y="690" width="300" height="110" as="geometry"/></mxCell><mxCell id="c1-31" value="&lt;b&gt;Connector A：A_event()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;→ WebSocket で外部へ&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="660" width="300" height="80" as="geometry"/></mxCell><mxCell id="c1-32" value="&lt;b&gt;Connector B：B_event()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;→ PCIFの形式で外部へ&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="800" width="300" height="80" as="geometry"/></mxCell><mxCell id="c1-33" value="&lt;b&gt;外部コンポーネント&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;A：APIサーバー／B：PCIF&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingTop=4;fontSize=12;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="720" width="260" height="90" as="geometry"/></mxCell><mxCell id="c1-34" value="on_ref_notified(101, 通知)" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;dashed=1;strokeColor=#2563EB;strokeWidth=1.8;fontColor=#1D4ED8;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c1-28" target="c1-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-35" value="on_info_event(EIF_Event)" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;dashed=1;strokeColor=#2563EB;strokeWidth=1.8;fontColor=#1D4ED8;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c1-29" target="c1-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-36" value="on_event（1番目：ID1）" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;dashed=1;strokeColor=#2563EB;strokeWidth=1.8;fontColor=#1D4ED8;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c1-30" target="c1-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-37" value="on_event（2番目：ID2）" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;dashed=1;strokeColor=#2563EB;strokeWidth=1.8;fontColor=#1D4ED8;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c1-30" target="c1-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-38" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;dashed=1;strokeColor=#2563EB;strokeWidth=1.8;fontColor=#1D4ED8;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c1-31" target="c1-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-39" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;dashed=1;strokeColor=#2563EB;strokeWidth=1.8;fontColor=#1D4ED8;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c1-32" target="c1-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-40" value="&lt;b&gt;ポイント&lt;/b&gt;：RIMへの購読は1回だけ。同じ通知を2つのConnectorへ配り分けるのはFrame（①の表）。Connectorは自分の on_event を登録するだけで、RIMの購読は意識しない。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c1-41" value="&lt;b&gt;比較&lt;/b&gt;&lt;table style=&#x27;border-collapse:collapse;margin-top:4px;&#x27;&gt;&lt;tr&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;観点&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;① Connector登録（EIF_RegisterConnector）&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;② 購読登録（EIF_Start）&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;目的&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;結果・通知の&lt;b&gt;届け先&lt;/b&gt;をEIFに教える&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;RIMの変化を&lt;b&gt;受け取る口&lt;/b&gt;をRIMに作る&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;呼ぶ人&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;各Connector&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;起動処理&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;呼ぶ回数&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;Connectorごとに1回（最大4）&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;全体で1回（中で公開イベントごとに RIM_Subscribe）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;呼ぶ時期&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;EIF_Setup の後、EIF_Start の前&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;全Connectorの登録の後&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;登録先&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;Frame（Connector登録表）&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;RIM（購読）＋ REF Accessor（監視の登録表）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;登録する中身&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;完了callback、イベントcallback、event_filter、user_context&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;購読するREFの通知、通知契機、呼ぶ関数（on_ref_notified）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;知っている必要があるもの&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;公開ID・公開API（eif_api.h）だけ&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;REFのID・通知（Accessorの対応表）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;いつ使われるか&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;完了・イベントを配るとき（誰に配るか）&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;RIMから通知が来たとき（何が起きたか）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;取り消し&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;できない（起動後は不変）&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:3px 6px;font-size:11px;text-align:left;&#x27;&gt;できない（RIMに解除APIが無い）&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1080" height="330" as="geometry"/></mxCell><mxCell id="c1-42" value="&lt;b&gt;凡例&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=13;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1160" y="1000" width="330" height="330" as="geometry"/></mxCell><mxCell id="c1-43" value="&lt;b&gt;型定義&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1174" y="1032" width="92" height="44" as="geometry"/></mxCell><mxCell id="c1-44" value="型（ヘッダー）の定義場所" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1276" y="1042" width="200" height="30" as="geometry"/></mxCell><mxCell id="c1-45" value="&lt;b&gt;変換表&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1174" y="1084" width="92" height="44" as="geometry"/></mxCell><mxCell id="c1-46" value="変換表・変換関数（型A→型B）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1276" y="1094" width="200" height="30" as="geometry"/></mxCell><mxCell id="c1-47" value="&lt;b&gt;定義表&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1174" y="1136" width="92" height="44" as="geometry"/></mxCell><mxCell id="c1-48" value="機種によらない表・つなぎ方の指定" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1276" y="1146" width="210" height="30" as="geometry"/></mxCell><mxCell id="c1-49" value="&lt;b&gt;実行時データ&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1174" y="1188" width="92" height="44" as="geometry"/></mxCell><mxCell id="c1-50" value="実行中に書き換わる表（登録表・台帳）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1276" y="1198" width="210" height="30" as="geometry"/></mxCell><mxCell id="c1-51" value="&lt;b&gt;ガード&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1174" y="1240" width="92" height="36" as="geometry"/></mxCell><mxCell id="c1-52" value="検査して弾く処理（NG時の戻り値）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1276" y="1246" width="210" height="30" as="geometry"/></mxCell><mxCell id="c1-53" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1174" y="1286" width="1" height="1" as="geometry"/></mxCell><mxCell id="c1-54" value="同期呼出し／戻り（破線）／非同期callback（青破線）" style="text;html=1;fontSize=11;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1276" y="1276" width="210" height="36" as="geometry"/></mxCell><mxCell id="c1-55" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=1.5;" edge="1" parent="1" source="c1-53" target="c1-54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-56" value="&lt;b&gt;補足&lt;/b&gt;：②は詳細設計書0.02の方式（REFの発生／解消の通知を公開イベントへ変換し、EIFは前回値を持たない）で描いている。実装は旧方式（異常情報リストを購読して差分を出す）のままで、②で購読する対象と監視の登録表の中身が異なる。" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#FFFBEB;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="1530" y="1000" width="850" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2.起動から通知までの時系列" id="c2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;起動から通知までの時系列&lt;/b&gt;&lt;/font&gt;　　Connector A・B の2つが同じ公開イベント（エラー発生）を受け取る例。①はConnectorの数だけ、②は1回、③で両方へ配る" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="c2-2" value="起動処理" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#475569;strokeWidt