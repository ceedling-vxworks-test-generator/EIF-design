etry x="2084" y="112" width="92" height="44" as="geometry"/></mxCell><mxCell id="s6-25" value="型（ヘッダー）の定義場所" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2186" y="122" width="200" height="30" as="geometry"/></mxCell><mxCell id="s6-26" value="&lt;b&gt;変換表&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2084" y="164" width="92" height="44" as="geometry"/></mxCell><mxCell id="s6-27" value="変換表・変換関数（型A→型B）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2186" y="174" width="200" height="30" as="geometry"/></mxCell><mxCell id="s6-28" value="&lt;b&gt;定義表&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2084" y="216" width="92" height="44" as="geometry"/></mxCell><mxCell id="s6-29" value="機種によらない表・つなぎ方の指定" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2186" y="226" width="210" height="30" as="geometry"/></mxCell><mxCell id="s6-30" value="&lt;b&gt;実行時データ&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2084" y="268" width="92" height="44" as="geometry"/></mxCell><mxCell id="s6-31" value="実行中に書き換わる表（登録表・台帳）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2186" y="278" width="210" height="30" as="geometry"/></mxCell><mxCell id="s6-32" value="&lt;b&gt;ガード&lt;/b&gt;" styl