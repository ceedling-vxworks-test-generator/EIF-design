<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" pages="6"><diagram name="1.EIF全体ブロック図（目標構成）" id="p1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-a1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;EIF全体ブロック図（目標構成）&lt;/b&gt;&lt;/font&gt;　APIサーバー／PCL／REF(RIM) との接続点まで　｜　同期・非同期／Frame・機種依存／コールバックの区別" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1400" height="40" as="geometry"/></mxCell><mxCell id="p1-AS" value="外部アプリケーション：APIサーバー（firmware-server / Rust：libpad_firm_external_interface.so）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="140" as="geometry"/></mxCell><mxCell id="p1-AS_REST" value="&lt;b&gt;REST処理（OpenAPI）&lt;/b&gt;&lt;br&gt;[C2] blockingスレッド群から&lt;br&gt;登録済みのCコールバックを呼ぶ&lt;br&gt;（複数要求が同時に来る）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="90" width="330" height="85" as="geometry"/></mxCell><mxCell id="p1-AS_WS" value="&lt;b&gt;WebSocket配信（AsyncAPI）&lt;/b&gt;&lt;br&gt;server_ws_emit_event()&lt;br&gt;イベントをコピーして即復帰&lt;br&gt;→ 非同期にクライアントへ配信" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="330" height="85" as="geometry"/></mxCell><mxCell id="p1-AS_MB" value="&lt;b&gt;印字データ受信（POST）&lt;/b&gt;&lt;br&gt;memory buffer（mb_*）へ書込み&lt;br&gt;set_handle() で受信開始を通知" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1050" y="90" width="330" height="85" as="geometry"/></mxCell><mxCell id="p1-BIND" value="Binding（binding/api_server/）… 外部アプリ側の部品。APIサーバーのヘッダを参照してよいのはここだけ。機種非依存" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1400" height="140" as="geometry"/></mxCell><mxCell id="p1-B_REST" value="&lt;b&gt;RestBinding&lt;/b&gt;&lt;br&gt;server_rest_callbacks_t を実装&lt;br&gt;APIサーバー型 ⇔ EIF公開モデル&lt;br&gt;EIF_Result → uc_result_t" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="330" height="85" as="geometry"/></mxCell><mxCell id="p1-B_EVT" value="&lt;b&gt;EventBinding&lt;/b&gt;&lt;br&gt;EIF_Event → ws_event_t&lt;br&gt;（job / error / warning / ink）&lt;br&gt;on_event を EIF へ注入" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="330" height="85" as="geometry"/></mxCell><mxCell id="p1-B_PD" value="&lt;b&gt;PrintDataSource（T.B.D）&lt;/b&gt;&lt;br&gt;memory buffer を&lt;br&gt;EIFの読出しポートとして提供" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1050" y="270" width="330" height="85" as="geometry"/></mxCell><mxCell id="p1-EIF" value="外部インタフェース層（EIF）本体 … 外部通信ライブラリのヘッダを参照しない" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fcfcfc;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1400" height="475" as="geometry"/></mxCell><mxCell id="p1-BOUND" value="&lt;b&gt;Boundary（include/）… 外部アプリが参照する唯一のヘッダ群・機種非依存&lt;/b&gt;&lt;br&gt;EIF_Setup / EIF_SetCallbacks / EIF_Start / EIF_SubmitRequest / EIF_CancelRequest / EIF_GetRequestResult / EIF_GetInfo / EIF_PatchSetting ｜ 公開ID（eif_public_id.h）・公開モデル（model/*.h）・EIF_Event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#b9e0a5;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="1360" height="55" as="geometry"/></mxCell><mxCell id="p1-FRAME" value="Frame（frame/）… 機種非依存の共通実装（全機種で再利用）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#eef7e8;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="930" height="350" as="geometry"/></mxCell><mxCell id="p1-F_RG" value="&lt;b&gt;RequestGateway&lt;/b&gt;&lt;br&gt;公開範囲判定（表に無ければ拒否）&lt;br&gt;公開要求→製品要求" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="550" width="200" height="75" as="geometry"/></mxCell><mxCell id="p1-F_SM" value="&lt;b&gt;SettingMerger&lt;/b&gt;&lt;br&gt;現在値＋パッチをマージ&lt;br&gt;→REFへ書込み（同期）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="310" y="550" width="190" height="75" as="geometry"/></mxCell><mxCell id="p1-F_IR" value="&lt;b&gt;InfoReader&lt;/b&gt;&lt;br&gt;REF取得＋変換&lt;br&gt;（同期）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="530" y="550" width="190" height="75" as="geometry"/></mxCell><mxCell id="p1-F_SUB" value="&lt;b&gt;SubscriptionManager&lt;/b&gt;&lt;br&gt;購読表の登録ループ&lt;br&gt;通知トランポリン／作業領域" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="550" width="215" height="75" as="geometry"/></mxCell><mxCell id="p1-F_RT" value="&lt;b&gt;RequestTracker&lt;/b&gt;&lt;br&gt;ハンドル⇔受付ID&lt;br&gt;完了トランポリン" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="150" y="655" width="130" height="75" as="geometry"/></mxCell><mxCell id="p1-F_ED" value="&lt;b&gt;EventDispatcher&lt;/b&gt;&lt;br&gt;注入された通知先へ配信&lt;br&gt;（要求完了・情報変化）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="655" width="180" height="75" as="geometry"/></mxCell><mxCell id="p1-F_PP" value="&lt;b&gt;PclPort&lt;/b&gt;（関数ポインタ構造体）&lt;br&gt;submit / cancel / get_result&lt;br&gt;→ PCL公開API（テスト時はスタブ）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="765" width="300" height="80" as="geometry"/></mxCell><mxCell id="p1-F_RP" value="&lt;b&gt;RefPort&lt;/b&gt;（関数ポインタ構造体）&lt;br&gt;subscribe / get_binary / set_binary&lt;br&gt;→ REFの&lt;u&gt;製品非依存&lt;/u&gt;API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="765" width="290" height="80" as="geometry"/></mxCell><mxCell id="p1-F_PDI" value="&lt;b&gt;PrintDataIngress&lt;/b&gt;&lt;br&gt;（T.B.D）[C5]&lt;br&gt;読出し→チャネル書込み" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="765" width="175" height="80" as="geometry"/></mxCell><mxCell id="p1-PROD" value="製品CFG（product/&amp;lt;MODEL&amp;gt;/）… 機種依存（ビルド時にMODELで1つ選択）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="515" width="390" height="350" as="geometry"/></mxCell><mxCell id="p1-P_SETUP" value="&lt;b&gt;EIF_Setup()&lt;/b&gt;：ProductProfile と Port を組み立て → EIF_Initialize()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1045" y="550" width="360" height="40" as="geometry"/></mxCell><mxCell id="p1-P_TBL" value="&lt;b&gt;ProductProfile（static const の表・1行=1公開ID）&lt;/b&gt;&lt;br&gt;・RequestMap：公開要求ID → PCL製品要求ID＋パラメータ変換&lt;br&gt;・InfoMap：公開情報ID → REFのID群＋型変換&lt;br&gt;・SettingMap：公開設定ID → マージ＋設定変更要求ID&lt;br&gt;・SubscriptionTable：REF ID・通知契機 → イベント生成&lt;br&gt;・コード対応表：Faultコード → 公開アラームID&lt;br&gt;&lt;i&gt;表に無いID＝公開しない（機能定義）&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1045" y="600" width="360" height="160" as="geometry"/></mxCell><mxCell id="p1-P_RULE" value="&lt;b&gt;変換ルール（純粋関数）&lt;/b&gt;&lt;br&gt;REF製品型（rim_types.h）⇔ 公開モデル&lt;br&gt;登録・送信・排他・スレッドは持たない" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1045" y="770" width="360" height="80" as="geometry"/></mxCell><mxCell id="p1-PCL" value="製品制御層（PCL）… RequestIngress.h / product_control_api.h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="640" height="175" as="geometry"/></mxCell><mxCell id="p1-PCL_API" value="&lt;b&gt;ExternalRequestIngressSubmit()&lt;/b&gt;&lt;br&gt;CancelRequestedByOwnerGeneration()&lt;br&gt;GetResult()&lt;br&gt;受付で即時復帰：UC_OK＋generation ID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="970" width="300" height="120" as="geometry"/></mxCell><mxCell id="p1-PCL_CB" value="&lt;b&gt;完了callbackの呼出し&lt;/b&gt;&lt;br&gt;[C3] 要求処理context（直列）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="970" width="280" height="55" as="geometry"/></mxCell><mxCell id="p1-PCL_CH" value="貯蔵チャネル 開設/閉塞（T.B.D）&lt;br&gt;実体はRSC。EIFは型のみ知る" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="380" y="1035" width="280" height="55" as="geometry"/></mxCell><mxCell id="p1-REF" value="参照サービス（REF）情報軸 RIM … EIFは参照・購読＋設定値の書込み（QA-01）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="935" width="680" height="175" as="geometry"/></mxCell><mxCell id="p1-RIM_SUB" value="&lt;b&gt;RIM_Subscribe()&lt;/b&gt;&lt;br&gt;購読登録（同期）&lt;br&gt;※購読解除APIなし" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="780" y="970" width="200" height="120" as="geometry"/></mxCell><mxCell id="p1-RIM_GET" value="&lt;b&gt;RIM_GetBinary()&lt;/b&gt;&lt;br&gt;RIM_SetBinary()（設定値）&lt;br&gt;RIM_GetCapabilityInt32() 他&lt;br&gt;取得・書込み（同期）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1000" y="970" width="200" height="120" as="geometry"/></mxCell><mxCell id="p1-RIM_WK" value="&lt;b&gt;通知Worker&lt;/b&gt;&lt;br&gt;登録されたcallbackを呼ぶ&lt;br&gt;[C4] RIM通知ワーカー" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1220" y="970" width="200" height="120" as="geometry"/></mxCell><mxCell id="p1-a2" value="① RESTコールバック呼出し（同期）[C2]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-AS_REST" target="p1-B_REST"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-a3" value="起動時：server_rest_register_callbacks()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#9933ff;fontColor=#7a00cc;dashed=1;dashPattern=1 3;strokeWidth=2;endArrow=diamond;endFill=0;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-B_REST" target="p1-AS_REST"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-a4" value="② EIF公開API（同期）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.129;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-B_REST" target="p1-BOUND"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.088;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-BOUND" target="p1-F_RG"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.254;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-BOUND" target="p1-F_SM"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1-a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.415;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;ent