<mxfile host="Electron" pages="10"><diagram name="1.定義の配置と利用" id="d1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d1-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;定義の配置と利用&lt;/b&gt;&lt;/font&gt;　　どの部品に、どの型定義・変換表・ガードがあり、誰が使うか（詳細設計書 6.8）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="d1-2" value="外部コンポーネント&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;APIサーバー（firmware-server）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="900" as="geometry"/></mxCell><mxCell id="d1-3" value="Connector&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;connectors/api_server/&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="320" height="900" as="geometry"/></mxCell><mxCell id="d1-4" value="公開ヘッダー（持ち主：Frame）&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;include/&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="670" y="70" width="300" height="900" as="geometry"/></mxCell><mxCell id="d1-5" value="Frame&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;frame/&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="360" height="900" as="geometry"/></mxCell><mxCell id="d1-6" value="下位IF（持ち主：Frame）&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;frame/include/eif_accessor_if.h&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1390" y="70" width="280" height="900" as="geometry"/></mxCell><mxCell id="d1-7" value="Accessor&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;accessors/pcl/、accessors/ref/（＋models/&amp;lt;MODEL&amp;gt;/）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1700" y="70" width="470" height="900" as="geometry"/></mxCell><mxCell id="d1-8" value="PCL／REF（RIM）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="2200" y="70" width="270" height="900" as="geometry"/></mxCell><mxCell id="d1-9" value="&lt;b&gt;job_type_t／job_create_request_t&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;ジョブ種別・ジョブ作成要求（OpenAPIから生成）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：APIサーバー、Connector&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="56" y="140" width="218" height="74" as="geometry"/></mxCell><mxCell id="d1-10" value="&lt;b&gt;network_settings_t／network_settings_patch_t&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;ネットワーク設定・部分更新&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：APIサーバー、Connector&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="56" y="226" width="218" height="74" as="geometry"/></mxCell><mxCell id="d1-11" value="&lt;b&gt;ws_event_t&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;WebSocketのイベント（job／error）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：APIサーバー、Connector&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="56" y="312" width="218" height="74" as="geometry"/></mxCell><mxCell id="d1-12" value="&lt;b&gt;uc_result_t（uc_types.h）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;APIサーバーの結果コード&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：APIサーバー、Connector&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="56" y="398" width="218" height="74" as="geometry"/></mxCell><mxCell id="d1-13" value="&lt;b&gt;server_rest_callbacks_t&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;RESTのcallback登録の型&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：APIサーバー、Connector&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="56" y="484" width="218" height="74" as="geometry"/></mxCell><mxCell id="d1-14" value="&lt;b&gt;k_jobs&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;job_type_t ⇔ 公開要求ID（機種によらない）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：rest_jobs_create、on_request_completed&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="140" width="288" height="74" as="geometry"/></mxCell><mxCell id="d1-15" value="&lt;b&gt;詰め替え（rest_get_network／rest_patch_network）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;network_settings(_patch)_t ⇔ 公開モデル&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：REST GET・PATCH&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="226" width="288" height="74" as="geometry"/></mxCell><mxCell id="d1-16" value="&lt;b&gt;to_uc&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Result → uc_result_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：REST の各callback&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="312" width="288" height="74" as="geometry"/></mxCell><mxCell id="d1-17" value="&lt;b&gt;完了・イベント → ws_event_t&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_RequestOutcome／EIF_Event → ws_event_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：on_request_completed、on_event&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="398" width="288" height="74" as="geometry"/></mxCell><mxCell id="d1-18" value="&lt;b&gt;PATCH待ち合わせ表（waiter_t）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;要求元トークン ⇔ 完了待ち（PCL経由時）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：rest_patch_network、on_request_completed&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="484" width="288" height="74" as="geometry"/></mxCell><mxCell id="d1-19" value="&lt;b&gt;C1 未知のジョブ種別&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;k_jobs に無い → UC_ERR_NOT_IMPLEMENTED&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="570" width="288" height="56" as="geometry"/></mxCell><mxCell id="d1-20" value="&lt;b&gt;C2 MACアドレスの変更&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;has_macaddress → UC_ERR_INVALID_PARAM&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="336" y="638" width="288" height="56" as="geometry"/></mxCell><mxCell id="d1-21" value="&lt;b&gt;eif_public_id.h&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;公開ID：要求・情報・設定・イベント（全機種共通の値）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：Connector、Frame、Accessor（素通し時は外部も）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="686" y="140" width="268" height="92" as="geometry"/></mxCell><mxCell id="d1-22" value="&lt;b&gt;eif_model.h&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;公開モデル：ネットワーク設定・パッチ・アラーム・アラーム一覧&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：Connector、Frame、Accessor&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="686" y="244" width="268" height="84" as="geometry"/></mxCell><mxCell id="d1-23" value="&lt;b&gt;eif_api.h&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;公開API、EIF_Result、EIF_RequestOutcome、EIF_ConnectorId、EIF_RequestHandle、EIF_Event、EIF_ConnectorDesc、callback型&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：Connector、起動処理（呼ぶ）、Frame・機種セットアップ（実装）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="686" y="340" width="268" height="110" as="geometry"/></mxCell><mxCell id="d1-24" value="&lt;b&gt;Connector登録表（eif_connector_t）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;callback・user_context・event_mask。EIF_Start()後は不変&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：ConnectorRegistry、Tracker、Dispatcher&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1016" y="140" width="328" height="72" as="geometry"/></mxCell><mxCell id="d1-25" value="&lt;b&gt;要求台帳（slot_t）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;要求ハンドル ⇔ チケット ⇔ 要求元・トークン&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：RequestGateway、RequestTracker&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1016" y="222" width="328" height="72" as="geometry"/></mxCell><mxCell id="d1-26" value="&lt;b&gt;設定定義表（k_settings）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;公開設定 → 現在値の公開情報・マージ関数&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：SettingMerger&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1016" y="304" width="328" height="72" as="geometry"/></mxCell><mxCell id="d1-27" value="&lt;b&gt;F1 構成の検証&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;下位IFの関数が欠けている → EIF_ERR_INVALID_CONFIG&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1016" y="386" width="328" height="52" as="geometry"/></mxCell><mxCell id="d1-28" value="&lt;b&gt;F2 状態&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;未初期化・未開始 → EIF_ERR_UNAVAILABLE&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1016" y="448" width="328" height="52" as="geometry"/></mxCell><mxCell id="d1-29" value="&lt;b&gt;F3 引数・要求元&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;NULL・未登録のorigin・param指定 → EIF_ERR_INVALID_PARAM&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1016" y="510" width="328" height="52" as="geometry"/></mxCell><mxCell id="d1-30" value="&lt;b&gt;F4 公開範囲&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;is_supported() が偽 → EIF_ERR_NOT_EXPOSED（PCL・REFへ渡さない）&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1016" y="572" width="328" height="52" as="geometry"/></mxCell><mxCell id="d1-31" value="&lt;b&gt;F5 サイズ照合&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;out_size／patch_size が型と不一致 → EIF_ERR_INVALID_PARAM&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1016" y="634" width="328" height="52" as="geometry"/></mxCell><mxCell id="d1-32" value="&lt;b&gt;F6 台帳の照合&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;台帳に無い・要求元が違う → EIF_ERR_NOT_FOUND&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1016" y="696" width="328" height="52" as="geometry"/></mxCell><mxCell id="d1-33" value="&lt;b&gt;F7 台帳満杯&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;PCL受付後に満杯 → cancel() を依頼して EIF_ERR_BUSY&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1016" y="758" width="328" height="52" as="geometry"/></mxCell><mxCell id="d1-34" value="&lt;b&gt;製品制御IF（EIF_ProductControlIf）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;is_supported・submit・cancel・query・set_done_handler&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：Frame（呼ぶ）、PCL Accessor（実装）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1406" y="140" width="248" height="92" as="geometry"/></mxCell><mxCell id="d1-35" value="&lt;b&gt;システム情報IF（EIF_SystemInfoIf）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;is_supported・public_size・read・is_event_supported・watch_event&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：Frame（呼ぶ）、REF Accessor（実装）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1406" y="244" width="248" height="92" as="geometry"/></mxCell><mxCell id="d1-36" value="&lt;b&gt;設定保存IF（EIF_SettingStoreIf）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;is_supported・store&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：Frame（呼ぶ）、REF Accessor（実装）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1406" y="348" width="248" height="80" as="geometry"/></mxCell><mxCell id="d1-37" value="&lt;b&gt;EIF_AccessorSet／EIF_Ticket&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;下位IF一式・Accessorが払い出す要求の識別子&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：機種セットアップ（つなぐ）、Frame&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1406" y="440" width="248" height="80" as="geometry"/></mxCell><mxCell id="d1-38" value="&lt;b&gt;pcl/&lt;/b&gt;（PCL Accessor）" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="1716" y="114" width="211" height="22" as="geometry"/></mxCell><mxCell id="d1-39" value="&lt;b&gt;ref/&lt;/b&gt;（REF Accessor）" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="1943" y="114" width="211" height="22" as="geometry"/></mxCell><mxCell id="d1-40" value="&lt;b&gt;g_pcl_request_map&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;models/MiniPrinter/：公開要求ID → 製品要求ID（その機種の分だけ）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：PCL Accessor（is_supported・submit）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1716" y="142" width="211" height="86" as="geometry"/></mxCell><mxCell id="d1-41" value="&lt;b&gt;pcl_accessor_map_uc&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;uc_result_t → EIF_Result&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：submit・cancel・query&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1716" y="240" width="211" height="74" as="geometry"/></mxCell><mxCell id="d1-42" value="&lt;b&gt;map_outcome&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;PCLの終端状態 → EIF_RequestOutcome&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：完了callback・query&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1716" y="326" width="211" height="74" as="geometry"/></mxCell><mxCell id="d1-43" value="&lt;b&gt;A1 表に無い公開要求ID&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;submit() で再確認 → EIF_ERR_NOT_EXPOSED&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1716" y="412" width="211" height="60" as="geometry"/></mxCell><mxCell id="d1-44" value="&lt;b&gt;g_ref_info_map＋変換関数&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;models/MiniPrinter/：公開情報ID → REFのID・型 → 公開モデル&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：REF Accessor（read）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1943" y="142" width="211" height="86" as="geometry"/></mxCell><mxCell id="d1-45" value="&lt;b&gt;g_ref_setting_map＋mp_network_from_public&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;公開モデル → REFの型（書込み）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：REF Accessor（store）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1943" y="240" width="211" height="86" as="geometry"/></mxCell><mxCell id="d1-46" value="&lt;b&gt;g_ref_event_map＋mp_fault_to_event&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REFの発生／解消の通知 → 公開イベント（名前は仮）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：REF Accessor（watch_event）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1943" y="338" width="211" height="86" as="geometry"/></mxCell><mxCell id="d1-47" value="&lt;b&gt;map_ri&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;RIStatus → EIF_Result&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：read・store・watch_event&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1943" y="436" width="211" height="74" as="geometry"/></mxCell><mxCell id="d1-48" value="&lt;b&gt;A2 REFの型の照合&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;取得したサイズ ≠ 表の型サイズ → EIF_ERR_INTERNAL&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1943" y="522" width="211" height="60" as="geometry"/></mxCell><mxCell id="d1-49" value="&lt;b&gt;A3 変換の失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;変更不可項目・IP形式 → INVALID_PARAM／INTERNAL。通知は捨てる&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.06;fontSize=11;spacingLeft=6;spacingRight=6;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1943" y="594" width="211" height="66" as="geometry"/></mxCell><mxCell id="d1-50" value="&lt;b&gt;product_request_id_t&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;製品要求ID（product_request_id.h。機種ごと）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：PCL、PCL Accessor&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2216" y="140" width="238" height="74" as="geometry"/></mxCell><mxCell id="d1-51" value="&lt;b&gt;uc_result_t／終端状態&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;external_request_execution_response_state_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：PCL、PCL Accessor&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2216" y="226" width="238" height="74" as="geometry"/></mxCell><mxCell id="d1-52" value="&lt;b&gt;RI_DATA_*（REF Data ID）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;rim_api.h（機種別）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：REF、REF Accessor（models/ だけ）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2216" y="312" width="238" height="74" as="geometry"/></mxCell><mxCell id="d1-53" value="&lt;b&gt;RIM_network_info_t／RIM_FaultInfoList&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REFの型（機種別）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：REF、REF Accessor（models/ だけ）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2216" y="398" width="238" height="74" as="geometry"/></mxCell><mxCell id="d1-54" value="&lt;b&gt;RIStatus／RI_BINARY&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;rim_api_common.h&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：REF、REF Accessor&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2216" y="484" width="238" height="74" as="geometry"/></mxCell><mxCell id="d1-55" value="機種セットアップ&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:11px&#x27;&gt;setup/&amp;lt;MODEL&amp;gt;/eif_setup.c&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1390" y="1000" width="780" height="130" as="geometry"/></mxCell><mxCell id="d1-56" value="&lt;b&gt;EIF_AccessorSet acc&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;製品制御→PCL Accessor、システム情報・設定保存→REF Accessor&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;使う：Frame（EIF_Frame_Initialize）&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=7;fontSize=11;spacingLeft=2;spacingRight=2;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1406" y="1046" width="360" height="72" as="geometry"/></mxCell><mxCell id="d1-57" value="どのAccessorをつなぐかだけを決める。設定の書込み先（REF直接／PCL経由）もここで選ぶ。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1786" y="1050" width="370" height="60" as="geometry"/></mxCell><mxCell id="d1-58" value="&lt;b&gt;誰が定義し、誰が使うか&lt;/b&gt;&lt;table style=&#x27;border-collapse:collapse;margin-top:6px;&#x27;&gt;&lt;tr&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;定義&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;外部コンポーネント&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;Connector&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;Frame&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;Accessor&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;機種セットアップ&lt;/th&gt;&lt;th style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;background:#E2E8F0;&#x27;&gt;PCL／REF&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;&#x27;&gt;公開ID（eif_public_id.h）&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;&#x27;&gt;素通し時のみ参照&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;&#x27;&gt;使う&lt;/td&gt;&lt;td style=&#x27;border:1px solid #94A3B8;padding:4px 6px;font-size:11px;text-align:left;&#x27;&gt;&lt;b&gt;定義&lt;/b&gt;（持ち主）・使う&lt;/td&gt;&lt;td style=&#x27;border:1p