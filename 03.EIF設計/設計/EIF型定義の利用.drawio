6" y="700" width="228" height="116" as="geometry"/></mxCell><mxCell id="t12-32" value="&lt;b&gt;③ 開始&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Start&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="512" y="700" width="228" height="116" as="geometry"/></mxCell><mxCell id="t12-33" value="&lt;b&gt;④ 要求受付&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_SubmitRequest／&lt;br&gt;CancelRequest／GetRequestResult&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="749" y="700" width="228" height="116" as="geometry"/></mxCell><mxCell id="t12-34" value="&lt;b&gt;⑤ 完了通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;PCLの完了 → on_request_completed&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="985" y="700" width="228" height="116" as="geometry"/></mxCell><mxCell id="t12-35" value="&lt;b&gt;⑥ 情報取得&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_GetInfo&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#1D4ED8&#x27;&gt;読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;info_is_supported()&lt;br&gt;info_public_size()&lt;br&gt;info_read()／setting_store()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1221" y="700" width="228" height="116" as="geometry"/></mxCell><mxCell id="t12-36" value="&lt;b&gt;⑦ 設定変更&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_PatchSetting&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#1D4ED8&#x27;&gt;読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;info_is_supported()&lt;br&gt;info_read()／setting_store()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1458" y="700" width="228" height="116" as="geometry"/></mxCell><mxCell id="t12-37" value="&lt;b&gt;⑧ イベント通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REFの通知 → on_event&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1694" y="700" width="228" height="116" as="geometry"/></mxCell><mxCell id="t12-38" value="メンバーの行：白＝どこかの機能が使う、灰色＝今の実装では読み書きする機能が無い。線の色は機能ごと。タイミングの番号は ① 起動 ② Connector登録 ③ 開始 ④ 要求受付 ⑤ 完了通知 ⑥ 情報取得 ⑦ 設定変更 ⑧ イベント通知" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="826" width="1890" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.3.3 RefSettingMapping" id="t13"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t13-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;3.3.3 RefSettingMapping（REF設定対応表）&lt;/b&gt;&lt;/font&gt;　　" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="t13-2" value="&lt;b&gt;概要&lt;/b&gt;　公開設定IDと、書込み先の REF Data ID・変換関数の対応。公開モデルに無い REF の項目は、現在値のコピーを土台にして保つ&lt;br&gt;&lt;b&gt;置き場所&lt;/b&gt;　accessors/ref/ref_accessor.h（型）・accessors/ref/models/&lt;MODEL&gt;/ref_maps.c（g_ref_setting_map）　（部品：Accessor）&lt;br&gt;&lt;b&gt;書き換わる時期&lt;/b&gt;　固定（const。機種ごと）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1890" height="96" as="geometry"/></mxCell><mxCell id="t13-3" value="&lt;b&gt;RefSettingMapping&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;REF設定対応表（3.3.3）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="500" height="56" as="geometry"/></mxCell><mxCell id="t13-4" value="&lt;b&gt;public_setting_id&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;eif_setting_id_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;公開設定ID&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：setting_is_supported(), setting_store()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="246" width="500" height="66" as="geometry"/></mxCell><mxCell id="t13-5" value="&lt;b&gt;current_info_id&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;eif_info_id_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;現在値（公開モデル）を取る公開情報ID（→ 3.3.2）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：setting_store()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="312" width="500" height="66" as="geometry"/></mxCell><mxCell id="t13-6" value="&lt;b&gt;ref_id&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;uint32_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;書込み先の REF Data ID&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：setting_store()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="378" width="500" height="66" as="geometry"/></mxCell><mxCell id="t13-7" value="&lt;b&gt;ref_size&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;size_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REF の型の sizeof&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：setting_store()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="444" width="500" height="66" as="geometry"/></mxCell><mxCell id="t13-8" value="&lt;b&gt;convert_func&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;FromPublicFunction&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;公開モデル → REF の型（変更できない項目の確認を含む）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：setting_store()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="510" width="500" height="66" as="geometry"/></mxCell><mxCell id="t13-9" value="&lt;b&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書く機能&lt;/span&gt;&lt;/b&gt;（機能 → メンバー）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t13-10" value="&lt;b&gt;&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読む機能&lt;/span&gt;&lt;/b&gt;（メンバー → 機能）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1490" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t13-11" value="&lt;b&gt;書く機能は無い&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;初期値はソースの表で決まる（const）。&lt;br&gt;実行中は書き換えない&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="440" height="80" as="geometry"/></mxCell><mxCell id="t13-12" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t13-11" target="t13-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-13" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t13-11" target="t13-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-14" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t13-11" target="t13-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-15" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t13-11" target="t13-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-16" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t13-11" target="t13-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-17" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑦ 設定変更&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.3.7&lt;/span&gt;&lt;br&gt;&lt;b&gt;setting_is_supported()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;public_setting_id&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;public_setting_id の行があれば公開している&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="190" width="440" height="76" as="geometry"/></mxCell><mxCell id="t13-18" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t13-4" target="t13-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-19" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑦ 設定変更&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.3.3&lt;/span&gt;&lt;br&gt;&lt;b&gt;setting_store()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;public_setting_id, current_info_id, ref_id, ref_size, convert_func&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;current_info_id の情報対応表で現在値を取り、ref_id の現在値（ref_size）をコピーして土台にし、convert_func で合成結果を反映して RIM_SetBinary(ref_id)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="288" width="440" height="136" as="geometry"/></mxCell><mxCell id="t13-20" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.167;" edge="1" parent="1" source="t13-4" target="t13-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-21" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.333;" edge="1" parent="1" source="t13-5" target="t13-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-22" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t13-6" target="t13-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-23" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.667;" edge="1" parent="1" source="t13-7" target="t13-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-24" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.833;" edge="1" parent="1" source="t13-8" target="t13-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t13-25" value="&lt;b&gt;使われるタイミング&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="606" width="400" height="24" as="geometry"/></mxCell><mxCell id="t13-26" value="&lt;b&gt;① 起動&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Setup&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t13-27" value="&lt;b&gt;② Connector登録&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_RegisterConnector&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="276" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t13-28" value="&lt;b&gt;③ 開始&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Start&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="512" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t13-29" value="&lt;b&gt;④ 要求受付&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_SubmitRequest／&lt;br&gt;CancelRequest／GetRequestResult&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="749" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t13-30" value="&lt;b&gt;⑤ 完了通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;PCLの完了 → on_request_completed&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="985" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t13-31" value="&lt;b&gt;⑥ 情報取得&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_GetInfo&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1221" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t13-32" value="&lt;b&gt;⑦ 設定変更&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_PatchSetting&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#1D4ED8&#x27;&gt;読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;setting_is_supported()&lt;br&gt;setting_store()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1458" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t13-33" value="&lt;b&gt;⑧ イベント通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REFの通知 → on_event&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1694" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t13-34" value="メンバーの行：白＝どこかの機能が使う、灰色＝今の実装では読み書きする機能が無い。線の色は機能ごと。タイミングの番号は ① 起動 ② Connector登録 ③ 開始 ④ 要求受付 ⑤ 完了通知 ⑥ 情報取得 ⑦ 設定変更 ⑧ イベント通知" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1890" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.3.4 RefEventMapping" id="t14"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t14-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;3.3.4 RefEventMapping（REFイベント対応表）&lt;/b&gt;&lt;/font&gt;　　" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="t14-2" value="&lt;b&gt;概要&lt;/b&gt;　公開イベントIDと、購読する REF の通知・指定できる通知方法・変換関数の対応。購読要求を REF の購読要求へ変換するために使う&lt;br&gt;&lt;b&gt;置き場所&lt;/b&gt;　accessors/ref/ref_accessor.h（型）・accessors/ref/models/&lt;MODEL&gt;/ref_maps.c（g_ref_event_map）　（部品：Accessor）&lt;br&gt;&lt;b&gt;書き換わる時期&lt;/b&gt;　固定（const。機種ごと）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1890" height="96" as="geometry"/></mxCell><mxCell id="t14-3" value="&lt;b&gt;RefEventMapping&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;REFイベント対応表（3.3.4）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="500" height="56" as="geometry"/></mxCell><mxCell id="t14-4" value="&lt;b&gt;public_event_id&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;eif_event_id_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;公開イベントID&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：info_is_event_supported(), info_watch_event(), on_ref_notified()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="246" width="500" height="66" as="geometry"/></mxCell><mxCell id="t14-5" value="&lt;b&gt;ref_source_id&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;uint32_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;購読する REF の通知（REF の Data ID）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：info_watch_event()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="312" width="500" height="66" as="geometry"/></mxCell><mxCell id="t14-6" value="&lt;b&gt;allow_on_change&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;bool&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;変化時の通知を指定できる&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：info_is_event_supported(), info_watch_event()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="378" width="500" height="66" as="geometry"/></mxCell><mxCell id="t14-7" value="&lt;b&gt;allow_periodic&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;bool&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;定期通知を指定できる&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：info_is_event_supported(), info_watch_event()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="444" width="500" height="66" as="geometry"/></mxCell><mxCell id="t14-8" value="&lt;b&gt;convert_func&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;ToEventFunction&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REF の通知内容 → 公開イベント（例：mp_fault_to_event）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：on_ref_notified()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="510" width="500" height="66" as="geometry"/></mxCell><mxCell id="t14-9" value="&lt;b&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書く機能&lt;/span&gt;&lt;/b&gt;（機能 → メンバー）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t14-10" value="&lt;b&gt;&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読む機能&lt;/span&gt;&lt;/b&gt;（メンバー → 機能）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1490" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t14-11" value="&lt;b&gt;書く機能は無い&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;初期値はソースの表で決まる（const）。&lt;br&gt;実行中は書き換えない&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="440" height="80" as="geometry"/></mxCell><mxCell id="t14-12" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t14-11" target="t14-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-13" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t14-11" target="t14-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-14" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t14-11" target="t14-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-15" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t14-11" target="t14-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-16" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t14-11" target="t14-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-17" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;③ 開始&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.3.7&lt;/span&gt;&lt;br&gt;&lt;b&gt;info_is_event_supported()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;public_event_id, allow_on_change, allow_periodic&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;行があり、購読要求の通知方法が許されていれば true&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="190" width="440" height="91" as="geometry"/></mxCell><mxCell id="t14-18" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.250;" edge="1" parent="1" source="t14-4" target="t14-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-19" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t14-6" target="t14-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-20" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.750;" edge="1" parent="1" source="t14-7" target="t14-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-21" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;③ 開始&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.3.6&lt;/span&gt;&lt;br&gt;&lt;b&gt;info_watch_event()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;public_event_id, allow_on_change, allow_periodic, ref_source_id&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;同じ確認のあと、ref_source_id を RI_SUBSCRIPTION_REQUEST の targetId にして RIM_Subscribe()。行は監視登録表の map に記録&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="303" width="440" height="121" as="geometry"/></mxCell><mxCell id="t14-22" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.200;" edge="1" parent="1" source="t14-4" target="t14-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-23" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.400;" edge="1" parent="1" source="t14-6" target="t14-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-24" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.600;" edge="1" parent="1" source="t14-7" target="t14-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-25" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.800;" edge="1" parent="1" source="t14-5" target="t14-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-26" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑧ イベント通知&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.3.6／4.3.3&lt;/span&gt;&lt;br&gt;&lt;b&gt;on_ref_notified()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;convert_func, public_event_id&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;監視登録表の map が指す行の convert_func(public_event_id, 通知内容) で EIF_Event を作る&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="446" width="440" height="91" as="geometry"/></mxCell><mxCell id="t14-27" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#15803D;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.333;" edge="1" parent="1" source="t14-8" target="t14-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-28" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#15803D;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.667;" edge="1" parent="1" source="t14-4" target="t14-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t14-29" value="&lt;b&gt;使われるタイミング&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="606" width="400" height="24" as="geometry"/></mxCell><mxCell id="t14-30" value="&lt;b&gt;① 起動&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Setup&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t14-31" value="&lt;b&gt;② Connector登録&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_RegisterConnector&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="276" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t14-32" value="&lt;b&gt;③ 開始&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Start&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#1D4ED8&#x27;&gt;読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;info_is_event_supported()&lt;br&gt;info_watch_event()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="512" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t14-33" value="&lt;b&gt;④ 要求受付&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_SubmitRequest／&lt;br&gt;CancelRequest／GetRequestResult&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="749" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t14-34" value="&lt;b&gt;⑤ 完了通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;PCLの完了 → on_request_completed&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="985" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t14-35" value="&lt;b&gt;⑥ 情報取得&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_GetInfo&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1221" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t14-36" value="&lt;b&gt;⑦ 設定変更&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_PatchSetting&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1458" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t14-37" value="&lt;b&gt;⑧ イベント通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REFの通知 → on_event&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#1D4ED8&#x27;&gt;読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;on_ref_notified()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1694" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t14-38" value="メンバーの行：白＝どこかの機能が使う、灰色＝今の実装では読み書きする機能が無い。線の色は機能ごと。タイミングの番号は ① 起動 ② Connector登録 ③ 開始 ④ 要求受付 ⑤ 完了通知 ⑥ 情報取得 ⑦ 設定変更 ⑧ イベント通知" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1890" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.3.5 WatchEntry" id="t15"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t15-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;3.3.5 WatchEntry（監視登録表）&lt;/b&gt;&lt;/font&gt;　　" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="t15-2" value="&lt;b&gt;概要&lt;/b&gt;　REF の購読ID と、通知を変換して渡す先（Frame の受け口・購読表の行）の対応。REF から通知が届いたときに引く&lt;br&gt;&lt;b&gt;置き場所&lt;/b&gt;　accessors/ref/ref_accessor.c（s_watch[8]）　（部品：Accessor）&lt;br&gt;&lt;b&gt;書き換わる時期&lt;/b&gt;　EIF_Start（watch_event）で作り、以降は不変" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1890" height="96" as="geometry"/></mxCell><mxCell id="t15-3" value="&lt;b&gt;WatchEntry&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;監視登録表（3.3.5）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="500" height="56" as="geometry"/></mxCell><mxCell id="t15-4" value="&lt;b&gt;used&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;bool&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;使用中&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：info_watch_event()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：info_watch_event(), on_ref_notified()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="246" width="500" height="66" as="geometry"/></mxCell><mxCell id="t15-5" value="&lt;b&gt;subscription_id&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;uint64_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REF が払い出した購読ID（通知時の検索キー）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：info_watch_event()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：on_ref_notified()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="312" width="500" height="66" as="geometry"/></mxCell><mxCell id="t15-6" value="&lt;b&gt;map&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;const RefEventMapping *&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REF イベント対応表の行（→ 3.3.4）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：info_watch_event()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：on_ref_notified()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="378" width="500" height="66" as="geometry"/></mxCell><mxCell id="t15-7" value="&lt;b&gt;fn&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;EIF_InfoEventFn&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Frame の受け口（on_info_event）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：info_watch_event()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：on_ref_notified()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="444" width="500" height="66" as="geometry"/></mxCell><mxCell id="t15-8" value="&lt;b&gt;ctx&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;void *&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Frame の購読表の行（→ 3.2.2）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：info_watch_event()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：on_ref_notified()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="510" width="500" height="66" as="geometry"/></mxCell><mxCell id="t15-9" value="&lt;b&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書く機能&lt;/span&gt;&lt;/b&gt;（機能 → メンバー）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t15-10" value="&lt;b&gt;&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読む機能&lt;/span&gt;&lt;/b&gt;（メンバー → 機能）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1490" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t15-11" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;③ 開始&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.3.6&lt;/span&gt;&lt;br&gt;&lt;b&gt;info_watch_event()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#C2410C;padding:0 3px;font-weight:bold&#x27;&gt;書&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;used, subscription_id, map, fn, ctx&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;RIM_Subscribe() が成功したら空き行に記録する。満杯（8）なら EIF_ERR_BUSY&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="440" height="91" as="geometry"/></mxCell><mxCell id="t15-12" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.167;entryX=0;entryY=0.5;" edge="1" parent="1" source="t15-11" target="t15-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-13" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.333;entryX=0;entryY=0.5;" edge="1" parent="1" source="t15-11" target="t15-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-14" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.500;entryX=0;entryY=0.5;" edge="1" parent="1" source="t15-11" target="t15-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-15" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.667;entryX=0;entryY=0.5;" edge="1" parent="1" source="t15-11" target="t15-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-16" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.833;entryX=0;entryY=0.5;" edge="1" parent="1" source="t15-11" target="t15-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-17" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;③ 開始&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.3.6&lt;/span&gt;&lt;br&gt;&lt;b&gt;info_watch_event()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;used&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;空き行を探す&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="190" width="440" height="76" as="geometry"/></mxCell><mxCell id="t15-18" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t15-4" target="t15-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-19" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑧ イベント通知&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.3.6&lt;/span&gt;&lt;br&gt;&lt;b&gt;on_ref_notified()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;used, subscription_id, map, fn, ctx&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;subscription_id で行を探し、map の変換関数で公開イベントにして fn(event, ctx) を呼ぶ。無ければ捨てる&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="288" width="440" height="91" as="geometry"/></mxCell><mxCell id="t15-20" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.167;" edge="1" parent="1" source="t15-4" target="t15-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-21" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.333;" edge="1" parent="1" source="t15-5" target="t15-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-22" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t15-6" target="t15-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-23" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.667;" edge="1" parent="1" source="t15-7" target="t15-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-24" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.833;" edge="1" parent="1" source="t15-8" target="t15-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t15-25" value="&lt;b&gt;使われるタイミング&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="606" width="400" height="24" as="geometry"/></mxCell><mxCell id="t15-26" value="&lt;b&gt;① 起動&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Setup&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t15-27" value="&lt;b&gt;② Connector登録&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_RegisterConnector&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="276" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t15-28" value="&lt;b&gt;③ 開始&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Start&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#C2410C&#x27;&gt;書く・読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;info_watch_event()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="512" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t15-29" value="&lt;b&gt;④ 要求受付&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_SubmitRequest／&lt;br&gt;CancelRequest／GetRequestResult&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="749" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t15-30" value="&lt;b&gt;⑤ 完了通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;PCLの完了 → on_request_completed&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="985" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t15-31" value="&lt;b&gt;⑥ 情報取得&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_GetInfo&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1221" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t15-32" value="&lt;b&gt;⑦ 設定変更&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_PatchSetting&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1458" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t15-33" value="&lt;b&gt;⑧ イベント通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REFの通知 → on_event&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#1D4ED8&#x27;&gt;読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;on_ref_notified()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1694" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t15-34" value="メンバーの行：白＝どこかの機能が使う、灰色＝今の実装では読み書きする機能が無い。線の色は機能ごと。タイミングの番号は ① 起動 ② Connector登録 ③ 開始 ④ 要求受付 ⑤ 完了通知 ⑥ 情報取得 ⑦ 設定変更 ⑧ イベント通知" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1890" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.3.6 EifSetupConfig" id="t16"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t16-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;3.3.6 EifSetupConfig（static const EIF_AccessorSet acc）（Accessor接続定義）&lt;/b&gt;&lt;/font&gt;　　" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="t16-2" value="&lt;b&gt;概要&lt;/b&gt;　機種ごとに、どの下位IFにどの Accessor をつなぐかを決める。型は下位IF一式（3.2.5）を使う&lt;br&gt;&lt;b&gt;置き場所&lt;/b&gt;　setup/&lt;MODEL&gt;/eif_setup.c（EIF_Setup() の中の acc）　（部品：機種セットアップ）&lt;br&gt;&lt;b&gt;書き換わる時期&lt;/b&gt;　固定（const。機種ごと）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1890" height="96" as="geometry"/></mxCell><mxCell id="t16-3" value="&lt;b&gt;EifSetupConfig（static const EIF_AccessorSet acc）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Accessor接続定義（3.3.6）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="500" height="56" as="geometry"/></mxCell><mxCell id="t16-4" value="&lt;b&gt;control&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;&amp;g_pcl_control_if&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;PCL Accessor（その機種の PCL 要求対応表）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：EIF_Setup()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="246" width="500" height="66" as="geometry"/></mxCell><mxCell id="t16-5" value="&lt;b&gt;info&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;&amp;g_ref_info_if&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REF Accessor（その機種の REF 対応表）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：EIF_Setup()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="312" width="500" height="66" as="geometry"/></mxCell><mxCell id="t16-6" value="&lt;b&gt;setting&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;&amp;g_ref_setting_if&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;設定の書込み先。PCL 経由にする場合はここを差し替える&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：EIF_Setup()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="378" width="500" height="66" as="geometry"/></mxCell><mxCell id="t16-7" value="&lt;b&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書く機能&lt;/span&gt;&lt;/b&gt;（機能 → メンバー）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t16-8" value="&lt;b&gt;&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読む機能&lt;/span&gt;&lt;/b&gt;（メンバー → 機能）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1490" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t16-9" value="&lt;b&gt;書く機能は無い&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;初期値はソースの表で決まる（const）。&lt;br&gt;実行中は書き換えない&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="440" height="80" as="geometry"/></mxCell><mxCell id="t16-10" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t16-9" target="t16-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id=