<mxfile host="Electron" pages="6"><diagram name="1.EIF全体構成" id="q1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q1-a1" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;EIF 全体構成&lt;/b&gt;&lt;/font&gt;　　接続先が変わっても、機種が変わっても、Frameは変えない" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1300" height="50" as="geometry"/></mxCell><mxCell id="q1-X1" value="&lt;b&gt;APIサーバー&lt;/b&gt;&lt;br&gt;REST / WebSocket" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#F1F5F9;strokeColor=#94A3B8;dashed=1;dashed=0;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="300" height="80" as="geometry"/></mxCell><mxCell id="q1-X2" value="&lt;b&gt;PCインタフェース&lt;/b&gt;&lt;br&gt;（将来）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#F1F5F9;strokeColor=#94A3B8;dashed=1;dashed=1;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="300" height="80" as="geometry"/></mxCell><mxCell id="q1-X3" value="&lt;b&gt;旧パネル・その他&lt;/b&gt;&lt;br&gt;（将来）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#F1F5F9;strokeColor=#94A3B8;dashed=1;dashed=1;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="300" height="80" as="geometry"/></mxCell><mxCell id="q1-EIF" value="外部インタフェース層（EIF）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontSize=16;fontStyle=1;strokeWidth=2;fillColor=#F8FAFC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="1300" height="830" as="geometry"/></mxCell><mxCell id="q1-CON" value="Connector（connectors/）… 接続先ごとに1つ。接続相手の違いをここで吸収する" style="rounded=0;wh