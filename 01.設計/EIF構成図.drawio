elative="1" as="geometry"><mxPoint x="368" y="410" as="sourcePoint"/><mxPoint x="582" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a15" value="③ EIF_SubmitRequest(公開要求ID, token=A1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="598" y="465" as="sourcePoint"/><mxPoint x="1042" y="465" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a16" value="④ 要求の表を引く" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#EA580C;fontColor=#C2410C;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1058" y="520" as="sourcePoint"/><mxPoint x="1272" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a17" value="⑤ Submit(製品要求ID, 完了トランポリン)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1058" y="575" as="sourcePoint"/><mxPoint x="1502" y="575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a18" value="受付ID（即時復帰）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1502" y="630" as="sourcePoint"/><mxPoint x="1058" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a19" value="要求台帳に記録：受付ID ⇔ 要求元A・token A1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="664" width="300" height="32" as="geometry"/></mxCell><mxCell id="q2-a20" value="EIF_ACCEPTED＋要求ハンドル" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1042" y="730" as="sourcePoint"/><mxPoint x="598" y="730" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a21" value="202＋job_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582" y="780" as="sourcePoint"/><mxPoint x="368" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a22" value="" style="rounded=0;fillColor=#F1F5F9;strokeColor=none;opacity=45;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1640" height="250" as="geometry"/></mxCell><mxCell id="q2-a23" value="&lt;b&gt;Connector B&lt;br&gt;からも要求&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="820" width="190" height="230" as="geometry"/></mxCell><mxCell id="q2-a24" value="③' EIF_SubmitRequest(token=B7)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="860" as="sourcePoint"/><mxPoint x="1042" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a25" value="⑤' Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1058" y="915" as="sourcePoint"/><mxPoint x="1502" y="915" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a26" value="要求台帳：受付ID ⇔ 要求元B・token B7" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="954" width="300" height="32" as="geometry"/></mxCell><mxCell id="q2-a27" value="EIF_ACCEPTED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1042" y="1020" as="sourcePoint"/><mxPoint x="828" y="1020" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a28" value="" style="rounded=0;fillColor=#DCFCE7;strokeColor=none;opacity=45;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1640" height="250" as="geometry"/></mxCell><mxCell id="q2-a29" value="&lt;b&gt;完了&lt;br&gt;（非同期）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="1090" width="190" height="230" as="geometry"/></mxCell><mxCell id="q2-a30" value="⑥ 完了（Bの要求が先に終わる）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1502" y="1130" as="sourcePoint"/><mxPoint x="1058" y="1130" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a31" value="⑦ on_request_completed(token=B7) → Bにだけ返す" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1042" y="1185" as="sourcePoint"/><mxPoint x="828" y="1185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a32" value="⑥ 完了（Aの要求）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1502" y="1240" as="sourcePoint"/><mxPoint x="1058" y="1240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a33" value="⑦ on_request_completed(token=A1) → Aにだけ返す" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1042" y="1295" as="sourcePoint"/><mxPoint x="598" y="1295" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q2-a34" value="&lt;b&gt;ポイント&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;■ 同期と非同期&lt;/b&gt;&lt;br&gt;受付（②〜⑤）は同期で、PCLは受付IDを返してすぐ戻る。実行結果は後から⑥の完了callbackで届く。&lt;br&gt;&lt;br&gt;&lt;b&gt;■ 応答先の振り分け&lt;/b&gt;&lt;br&gt;PCLは「1つ前の相手（EIF）」しか知らない。EIFは要求台帳で「受付ID → 要求元Connector・token」を覚え、完了の順番が入れ替わっても正しい要求元に返す。&lt;br&gt;&lt;br&gt;&lt;b&gt;■ コールバックの仕組み&lt;/b&gt;&lt;br&gt;・Connectorは起動時に完了callbackをEIFへ登録する（①）&lt;br&gt;・EIFは要求のたびに、共通の完了トランポリンをPCLへ渡す（⑤）&lt;br&gt;・Connectorは token で自分の要求（REST要求、旧コマンド等）と結果を対応付ける" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fillColor=#FFFFFF;strokeColor=#64748B;spacing=14;" vertex="1" parent="1"><mxGeometry x="1720" y="150" width="380" height="640" as="geometry"/></mxCell><mxCell id="q2-a35" value="&lt;b&gt;実行コンテキスト&lt;/b&gt;&lt;br&gt;&lt;br&gt;②〜⑤：Connectorのスレッド&lt;br&gt;（APIサーバーのblockingスレッド）&lt;br&gt;&lt;br&gt;⑥〜⑦：PCLの要求処理context&lt;br&gt;（直列。callbackの中でEIFの要求系APIを呼ばない。長時間ブロックしない）&lt;br&gt;&lt;br&gt;EIFは自前のタスクを挟まない" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fillColor=#FFFFFF;strokeColor=#64748B;spacing=14;" vertex="1" parent="1"><mxGeometry x="1720" y="830" width="380" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.情報取得・設定変更・購読" id="q3"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q3-a1" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;情報取得・設定変更・購読の流れ&lt;/b&gt;&lt;/font&gt;　　機種固有のIDと型は製品CFGだけが知る" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1500" height="50" as="geometry"/></mxCell><mxCell id="q3-E" value="&lt;b&gt;APIサーバー&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#F1F5F9;strokeColor=#94A3B8;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="200" height="50" as="geometry"/></mxCell><mxCell id="q3-a2" value="" style="rounded=0;fillColor=#CBD5E1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="359" y="120" width="3" height="1300" as="geometry"/></mxCell><mxCell id="q3-C" value="&lt;b&gt;Connector&lt;br&gt;（api_server）&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#DBEAFE;strokeColor=#3B82F6;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="200" height="50" as="geometry"/></mxCell><mxCell id="q3-a3" value="" style="rounded=0;fillColor=#CBD5E1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="589" y="120" width="3" height="1300" as="geometry"/></mxCell><mxCell id="q3-F" value="&lt;b&gt;EIF Frame&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#DCFCE7;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="200" height="50" as="geometry"/></mxCell><mxCell id="q3-a4" value="" style="rounded=0;fillColor=#CBD5E1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="819" y="120" width="3" height="1300" as="geometry"/></mxCell><mxCell id="q3-P" value="&lt;b&gt;製品CFG&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#FFEDD5;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="950" y="70" width="200" height="50" as="geometry"/></mxCell><mxCell id="q3-a5" value="" style="rounded=0;fillColor=#CBD5E1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1049" y="120" width="3" height="1300" as="geometry"/></mxCell><mxCell id="q3-R" value="&lt;b&gt;REF（RIM）&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1180" y="70" width="200" height="50" as="geometry"/></mxCell><mxCell id="q3-a6" value="" style="rounded=0;fillColor=#CBD5E1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1279" y="120" width="3" height="1300" as="geometry"/></mxCell><mxCell id="q3-PCL" value="&lt;b&gt;PCL&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1410" y="70" width="200" height="50" as="geometry"/></mxCell><mxCell id="q3-a7" value="" style="rounded=0;fillColor=#CBD5E1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1509" y="120" width="3" height="1300" as="geometry"/></mxCell><mxCell id="q3-a8" value="" style="rounded=0;fillColor=#FEF9C3;strokeColor=none;opacity=45;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1640" height="340" as="geometry"/></mxCell><mxCell id="q3-a9" value="&lt;b&gt;情報取得&lt;br&gt;（同期）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="190" height="320" as="geometry"/></mxCell><mxCell id="q3-a10" value="network_settings.get" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="368" y="200" as="sourcePoint"/><mxPoint x="582" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a11" value="EIF_GetInfo(公開情報ID)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="598" y="255" as="sourcePoint"/><mxPoint x="812" y="255" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a12" value="情報の表のREF IDで取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="310" as="sourcePoint"/><mxPoint x="1272" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a13" value="変換関数（REF製品型 → 公開モデル）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#EA580C;fontColor=#C2410C;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="365" as="sourcePoint"/><mxPoint x="1042" y="365" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a14" value="EIF_OK＋公開モデル" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="812" y="420" as="sourcePoint"/><mxPoint x="598" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a15" value="network_settings_t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582" y="470" as="sourcePoint"/><mxPoint x="368" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a16" value="" style="rounded=0;fillColor=#FFEDD5;strokeColor=none;opacity=45;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="1640" height="470" as="geometry"/></mxCell><mxCell id="q3-a17" value="&lt;b&gt;設定変更&lt;br&gt;（書込み先は&lt;br&gt;表の1列で切替）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="520" width="190" height="450" as="geometry"/></mxCell><mxCell id="q3-a18" value="network_settings.patch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="368" y="560" as="sourcePoint"/><mxPoint x="582" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a19" value="EIF_PatchSetting(公開設定ID, パッチ)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="598" y="615" as="sourcePoint"/><mxPoint x="812" y="615" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a20" value="現在値を取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="670" as="sourcePoint"/><mxPoint x="1272" y="670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a21" value="マージ関数（未指定項目は現在値のまま）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#EA580C;fontColor=#C2410C;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="725" as="sourcePoint"/><mxPoint x="1042" y="725" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a22" value="&lt;b&gt;sink = REF_DIRECT（現在）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#C2410C;" vertex="1" parent="1"><mxGeometry x="250" y="771" width="1360" height="30" as="geometry"/></mxCell><mxCell id="q3-a23" value="書込み（同期）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="815" as="sourcePoint"/><mxPoint x="1272" y="815" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a24" value="EIF_OK（完了）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="812" y="865" as="sourcePoint"/><mxPoint x="598" y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a25" value="&lt;b&gt;sink = PCL_REQUEST（QA-01でPCL経由になった場合）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#C2410C;" vertex="1" parent="1"><mxGeometry x="250" y="906" width="1360" height="30" as="geometry"/></mxCell><mxCell id="q3-a26" value="設定変更要求 → EIF_ACCEPTED、結果は完了callback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;dashed=1;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="950" as="sourcePoint"/><mxPoint x="1502" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a27" value="" style="rounded=0;fillColor=#DCFCE7;strokeColor=none;opacity=45;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1640" height="410" as="geometry"/></mxCell><mxCell id="q3-a28" value="&lt;b&gt;情報変化の&lt;br&gt;通知&lt;br&gt;（非同期）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="1010" width="190" height="390" as="geometry"/></mxCell><mxCell id="q3-a29" value="起動時：購読の表の各行を RIM_Subscribe（トランポリンを登録）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7C3AED;fontColor=#6D28D9;dashed=1;dashPattern=2 4;strokeWidth=2.5;endArrow=diamond;endFill=0;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="1050" as="sourcePoint"/><mxPoint x="1272" y="1050" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a30" value="変化通知（変化時／定期）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1272" y="1110" as="sourcePoint"/><mxPoint x="828" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a31" value="最新値を取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="1165" as="sourcePoint"/><mxPoint x="1272" y="1165" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a32" value="StateCache：前回値を取り出す" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=14;spacing=8;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="1199" width="280" height="32" as="geometry"/></mxCell><mxCell id="q3-a33" value="イベント生成関数（今回値・前回値 → 発生／解消）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#EA580C;fontColor=#C2410C;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828" y="1265" as="sourcePoint"/><mxPoint x="1042" y="1265" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a34" value="on_event（event_filterに一致するConnectorだけ）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="812" y="1320" as="sourcePoint"/><mxPoint x="598" y="1320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a35" value="server_ws_emit_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="582" y="1375" as="sourcePoint"/><mxPoint x="368" y="1375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q3-a36" value="&lt;b&gt;ポイント&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;■ 機種依存の閉じ込め&lt;/b&gt;&lt;br&gt;REFのID（RI_DATA_*）と型（RIM_network_info_t 等）は、製品CFGの表と変換関数だけが知る。Frameはポインタとサイズしか扱わない。&lt;br&gt;&lt;br&gt;&lt;b&gt;■ 書込み先の切替&lt;/b&gt;&lt;br&gt;REFへ直接書くかPCL経由にするかは未決（QA-01）。設定の表の sink 列だけで切り替えられる。Connectorは EIF_OK／EIF_ACCEPTED の両方を扱うので変更不要。&lt;br&gt;&lt;br&gt;&lt;b&gt;■ 差分導出&lt;/b&gt;&lt;br&gt;異常リストのように一覧で来る情報は、StateCacheの前回値と比べて発生／解消を1件ずつ作る（QA-03）。データを持つのはStateCacheだけ。&lt;br&gt;&lt;br&gt;&lt;b&gt;■ 定期通知&lt;/b&gt;&lt;br&gt;EIFはタイマーを持たない。定期的に送る情報はREFの定期通知を購読する。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fillColor=#FFFFFF;strokeColor=#64748B;spacing=14;" vertex="1" parent="1"><mxGeometry x="1720" y="150" width="380" height="620" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4.フォルダ構成" id="q4"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q4-a1" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;フォルダ構成&lt;/b&gt;&lt;/font&gt;　　フォルダを見れば、接続先依存・機種依存・共通が分かる" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1500" height="50" as="geometry"/></mxCell><mxCell id="q4-a2" value="フォルダ／ファイル" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#E2E8F0;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="460" height="40" as="geometry"/></mxCell><mxCell id="q4-a3" value="区分" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#E2E8F0;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="140" height="40" as="geometry"/></mxCell><mxCell id="q4-a4" value="役割" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#E2E8F0;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="560" height="40" as="geometry"/></mxCell><mxCell id="q4-a5" value="&lt;b&gt;externalInterfaceLayer/&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=10;strokeColor=#CBD5E1;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="460" height="40" as="geometry"/></mxCell><mxCell id="q4-a6" value="-" style="rounded=0