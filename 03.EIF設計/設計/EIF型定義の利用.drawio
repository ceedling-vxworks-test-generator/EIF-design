 as="geometry"></mxGeometry></mxCell><mxCell id="t4-15" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t4-5" target="t4-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t4-16" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.750;" edge="1" parent="1" source="t4-6" target="t4-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t4-17" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;② Connector登録&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.2.4&lt;/span&gt;&lt;br&gt;&lt;b&gt;EIF_RegisterConnector()&lt;br&gt;→ subscriptions_valid()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;id, type, interval_ms&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;形を検査する（id の範囲・重複、type と interval_ms の組合せ、その公開イベントで指定できる通知方法）。正しければ Connector登録表（3.2.1）へ写す&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="318" width="440" height="121" as="geometry"/></mxCell><mxCell id="t4-18" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.250;" edge="1" parent="1" source="t4-4" target="t4-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t4-19" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t4-5" target="t4-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t4-20" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.750;" edge="1" parent="1" source="t4-6" target="t4-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t4-21" value="&lt;b&gt;使われるタイミング&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="491" width="400" height="24" as="geometry"/></mxCell><mxCell id="t4-22" value="&lt;b&gt;① 起動&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Setup&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="519" width="228" height="116" as="geometry"/></mxCell><mxCell id="t4-23" value="&lt;b&gt;② Connector登録&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_RegisterConnector&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#1D4ED8&#x27;&gt;読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_RegisterConnector()&lt;br&gt;EifApiServerConnector_Setup()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="276" y="519" width="228" height="116" as="geometry"/></mxCell><mxCell id="t4-24" value="&lt;b&gt;③ 開始&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Start&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="512" y="519" width="228" height="116" as="geometry"/></mxCell><mxCell id="t4-25" value="&lt;b&gt;④ 要求受付&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_SubmitRequest／&lt;br&gt;CancelRequest／GetRequestResult&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="749" y="519" width="228" height="116" as="geometry"/></mxCell><mxCell id="t4-26" value="&lt;b&gt;⑤ 完了通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;PCLの完了 → on_request_completed&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="985" y="519" width="228" height="116" as="geometry"/></mxCell><mxCell id="t4-27" value="&lt;b&gt;⑥ 情報取得&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_GetInfo&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1221" y="519" width="228" height="116" as="geometry"/></mxCell><mxCell id="t4-28" value="&lt;b&gt;⑦ 設定変更&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_PatchSetting&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1458" y="519" width="228" height="116" as="geometry"/></mxCell><mxCell id="t4-29" value="&lt;b&gt;⑧ イベント通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REFの通知 → on_event&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1694" y="519" width="228" height="116" as="geometry"/></mxCell><mxCell id="t4-30" value="メンバーの行：白＝どこかの機能が使う、灰色＝今の実装では読み書きする機能が無い。線の色は機能ごと。タイミングの番号は ① 起動 ② Connector登録 ③ 開始 ④ 要求受付 ⑤ 完了通知 ⑥ 情報取得 ⑦ 設定変更 ⑧ イベント通知" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="1890" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.1.5 PendingEntry" id="t5"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t5-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;3.1.5 PendingEntry（完了待ち合わせ表）&lt;/b&gt;&lt;/font&gt;　　" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="t5-2" value="&lt;b&gt;概要&lt;/b&gt;　REST PATCH は同期応答のため、EIF が EIF_ACCEPTED（PCL経由）を返したときに、完了callbackを上限5秒まで待ち合わせる表&lt;br&gt;&lt;b&gt;置き場所&lt;/b&gt;　connectors/api_server/api_server_connector.c（s_pending[4]、s_wait_lock で保護）　（部品：Connector）&lt;br&gt;&lt;b&gt;書き換わる時期&lt;/b&gt;　実行中（同期応答の PATCH のたびに確保・解放）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1890" height="96" as="geometry"/></mxCell><mxCell id="t5-3" value="&lt;b&gt;PendingEntry&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;完了待ち合わせ表（3.1.5）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="500" height="56" as="geometry"/></mxCell><mxCell id="t5-4" value="&lt;b&gt;used&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;bool&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;使用中&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：pending_acquire(), &lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：pending_signal()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="246" width="500" height="66" as="geometry"/></mxCell><mxCell id="t5-5" value="&lt;b&gt;done&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;bool&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;完了callbackが届いた&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：pending_acquire(), pending_signal()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：pending_wait_and_release()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="312" width="500" height="66" as="geometry"/></mxCell><mxCell id="t5-6" value="&lt;b&gt;token&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;uint64_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;待っている要求元トークン（待ち合わせのキー）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：pending_acquire()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：pending_signal()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="378" width="500" height="66" as="geometry"/></mxCell><mxCell id="t5-7" value="&lt;b&gt;outcome&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;EIF_RequestOutcome&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;届いた終端結果&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：pending_signal()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：pending_wait_and_release()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="444" width="500" height="66" as="geometry"/></mxCell><mxCell id="t5-8" value="&lt;b&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書く機能&lt;/span&gt;&lt;/b&gt;（機能 → メンバー）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t5-9" value="&lt;b&gt;&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読む機能&lt;/span&gt;&lt;/b&gt;（メンバー → 機能）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1490" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t5-10" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑦ 設定変更&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.1.4&lt;/span&gt;&lt;br&gt;&lt;b&gt;rest_patch_network()&lt;br&gt;→ pending_acquire()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#C2410C;padding:0 3px;font-weight:bold&#x27;&gt;書&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;used, done, token&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;EIF を呼ぶ前に確保する（used＝true、done＝false、token）。先着完了に備える&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="440" height="106" as="geometry"/></mxCell><mxCell id="t5-11" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.250;entryX=0;entryY=0.5;" edge="1" parent="1" source="t5-10" target="t5-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5-12" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.500;entryX=0;entryY=0.5;" edge="1" parent="1" source="t5-10" target="t5-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5-13" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.750;entryX=0;entryY=0.5;" edge="1" parent="1" source="t5-10" target="t5-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5-14" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑤ 完了通知&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.1.5&lt;/span&gt;&lt;br&gt;&lt;b&gt;on_request_completed()&lt;br&gt;→ pending_signal()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#C2410C;padding:0 3px;font-weight:bold&#x27;&gt;書&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;done, outcome&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;届いた完了を書く（done＝true、outcome）&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="440" height="91" as="geometry"/></mxCell><mxCell id="t5-15" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.333;entryX=0;entryY=0.5;" edge="1" parent="1" source="t5-14" target="t5-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5-16" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.667;entryX=0;entryY=0.5;" edge="1" parent="1" source="t5-14" target="t5-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5-17" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑦ 設定変更&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.1.4&lt;/span&gt;&lt;br&gt;&lt;b&gt;pending_wait_and_release()&lt;br&gt;／rest_patch_network()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#C2410C;padding:0 3px;font-weight:bold&#x27;&gt;書&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;used&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;応答したら解放する（used＝false）。EIF_OK で同期完了したときも解放&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="440" height="106" as="geometry"/></mxCell><mxCell id="t5-18" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#15803D;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.500;entryX=0;entryY=0.5;" edge="1" parent="1" source="t5-17" target="t5-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5-19" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑤ 完了通知&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.1.5&lt;/span&gt;&lt;br&gt;&lt;b&gt;on_request_completed()&lt;br&gt;→ pending_signal()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;used, token&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;使用中の行を要求元トークンで探す&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="190" width="440" height="91" as="geometry"/></mxCell><mxCell id="t5-20" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.333;" edge="1" parent="1" source="t5-4" target="t5-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5-21" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.667;" edge="1" parent="1" source="t5-6" target="t5-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5-22" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑦ 設定変更&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.1.4&lt;/span&gt;&lt;br&gt;&lt;b&gt;rest_patch_network()&lt;br&gt;→ pending_wait_and_release()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;done, outcome&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;done になるまで待ち（上限5秒）、outcome から応答を決める&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="303" width="440" height="106" as="geometry"/></mxCell><mxCell id="t5-23" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.333;" edge="1" parent="1" source="t5-5" target="t5-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5-24" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.667;" edge="1" parent="1" source="t5-7" target="t5-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t5-25" value="&lt;b&gt;使われるタイミング&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="589" width="400" height="24" as="geometry"/></mxCell><mxCell id="t5-26" value="&lt;b&gt;① 起動&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Setup&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="617" width="228" height="116" as="geometry"/></mxCell><mxCell id="t5-27" value="&lt;b&gt;② Connector登録&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_RegisterConnector&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="276" y="617" width="228" height="116" as="geometry"/></mxCell><mxCell id="t5-28" value="&lt;b&gt;③ 開始&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Start&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="512" y="617" width="228" height="116" as="geometry"/></mxCell><mxCell id="t5-29" value="&lt;b&gt;④ 要求受付&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_SubmitRequest／&lt;br&gt;CancelRequest／GetRequestResult&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="749" y="617" width="228" height="116" as="geometry"/></mxCell><mxCell id="t5-30" value="&lt;b&gt;⑤ 完了通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;PCLの完了 → on_request_completed&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#C2410C&#x27;&gt;書く・読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;on_request_completed()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="985" y="617" width="228" height="116" as="geometry"/></mxCell><mxCell id="t5-31" value="&lt;b&gt;⑥ 情報取得&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_GetInfo&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1221" y="617" width="228" height="116" as="geometry"/></mxCell><mxCell id="t5-32" value="&lt;b&gt;⑦ 設定変更&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_PatchSetting&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#C2410C&#x27;&gt;書く・読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;pending_wait_and_release()&lt;br&gt;rest_patch_network()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1458" y="617" width="228" height="116" as="geometry"/></mxCell><mxCell id="t5-33" value="&lt;b&gt;⑧ イベント通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REFの通知 → on_event&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1694" y="617" width="228" height="116" as="geometry"/></mxCell><mxCell id="t5-34" value="メンバーの行：白＝どこかの機能が使う、灰色＝今の実装では読み書きする機能が無い。線の色は機能ごと。タイミングの番号は ① 起動 ② Connector登録 ③ 開始 ④ 要求受付 ⑤ 完了通知 ⑥ 情報取得 ⑦ 設定変更 ⑧ イベント通知" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="743" width="1890" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.2.1 ConnectorEntry" id="t6"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t6-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;3.2.1 ConnectorEntry（Connector登録表）&lt;/b&gt;&lt;/font&gt;　　" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="t6-2" value="&lt;b&gt;概要&lt;/b&gt;　登録済みの Connector の callback・user_context・購読要求の写しを持つ表。完了通知・イベント通知の届け先を決めるために使う&lt;br&gt;&lt;b&gt;置き場所&lt;/b&gt;　frame/eif_frame_internal.h（型）・frame/connector/eif_connector_registry.c（s_connectors[4]）　（部品：Frame）&lt;br&gt;&lt;b&gt;書き換わる時期&lt;/b&gt;　起動時（EIF_RegisterConnector）に書き、EIF_Start で締め切る。以降は不変のためロックなしで読む" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;fillColor=#F0FDF4;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1890" height="96" as="geometry"/></mxCell><mxCell id="t6-3" value="&lt;b&gt;ConnectorEntry&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;Connector登録表（3.2.1）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="500" height="56" as="geometry"/></mxCell><mxCell id="t6-4" value="&lt;b&gt;id&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;EIF_ConnectorId&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;Connector ID（登録順に1から）。ビット (id-1) が購読表の connector_mask&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：EIF_RegisterConnector()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：build_table(), EIF_PatchSetting()  eif_registry_get(), eif_tracker_notify(), eif_dispatch_event()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="246" width="500" height="66" as="geometry"/></mxCell><mxCell id="t6-5" value="&lt;b&gt;name&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;const char *&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;ログ用&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：EIF_RegisterConnector()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：－&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="312" width="500" height="66" as="geometry"/></mxCell><mxCell id="t6-6" value="&lt;b&gt;on_request_completed&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;EIF_RequestCompletedFn&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;完了callback&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：EIF_RegisterConnector()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：eif_tracker_notify()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="378" width="500" height="66" as="geometry"/></mxCell><mxCell id="t6-7" value="&lt;b&gt;on_event&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;EIF_EventFn&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;イベントcallback（NULL可）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：EIF_RegisterConnector()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：eif_dispatch_event()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="444" width="500" height="66" as="geometry"/></mxCell><mxCell id="t6-8" value="&lt;b&gt;user_context&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;void *&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;callback へそのまま渡す値&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：EIF_RegisterConnector()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：eif_tracker_notify(), eif_dispatch_event()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="510" width="500" height="66" as="geometry"/></mxCell><mxCell id="t6-9" value="&lt;b&gt;subscriptions[]&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;EIF_SubscriptionRequest[EIF_EVT_COUNT]&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;登録時に写した購読要求（← 3.1.4）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：EIF_RegisterConnector()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：build_table()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="576" width="500" height="66" as="geometry"/></mxCell><mxCell id="t6-10" value="&lt;b&gt;subscription_count&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;size_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;subscriptions の件数&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：EIF_RegisterConnector()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：build_table()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="642" width="500" height="66" as="geometry"/></mxCell><mxCell id="t6-11" value="&lt;b&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書く機能&lt;/span&gt;&lt;/b&gt;（機能 → メンバー）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t6-12" value="&l