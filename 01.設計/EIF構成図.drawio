_handle / set_handle）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="320" height="70" as="geometry"/></mxCell><mxCell id="p3-AS_WS" value="server_ws_emit_event()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="330" height="70" as="geometry"/></mxCell><mxCell id="p3-EIF" value="src/externalInterfaceLayer（現行）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fcfcfc;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1100" height="500" as="geometry"/></mxCell><mxCell id="p3-ADP" value="ApiServerAdapter/" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="275" width="640" height="450" as="geometry"/></mxCell><mxCell id="p3-ADP_INC" value="include/api_server_rest_adapter.h ｜ include/ws/api_server_ws_subscribe.h, *_publisher.h（公開ヘッダ）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="310" width="600" height="45" as="geometry"/></mxCell><mxCell id="p3-REST" value="&lt;b&gt;src/rest/&lt;/b&gt; settings.c / jobs.c / control.c / status.c / information.c / storage.c&lt;br&gt;&lt;br&gt;・settings_get_network：&lt;font color='#cc0000'&gt;RIM_GetNetworkInfo / GetHostname / GetMacAddress&lt;/font&gt; → 文字列化 → network_settings_t&lt;br&gt;・settings_patch_network：&lt;font color='#cc0000'&gt;RIM_SetNetworkInfo&lt;/font&gt;&lt;br&gt;・その他：UC_ERR_NOT_IMPLEMENTED のスタブ群（jobsも未接続）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="375" width="290" height="205" as="geometry"/></mxCell><mxCell id="p3-REST_ADP" value="api_server_rest_adapter.c&lt;br&gt;各 *_Configure を集約 → server_rest_register_callbacks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="290" height="55" as="geometry"/></mxCell><mxCell id="p3-WS_SUB" value="&lt;b&gt;ws/api_server_ws_subscribe.c&lt;/b&gt;&lt;br&gt;k_subscriptions：&lt;font color='#cc0000'&gt;RI_DATA_FAULT_INFO_LIST&lt;/font&gt; → ApiServerWsCallback_FaultInfoList&lt;br&gt;RIM_Subscribe ループ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="375" width="290" height="95" as="geometry"/></mxCell><mxCell id="p3-WS_CB" value="&lt;b&gt;ws/api_server_ws_callbacks.c&lt;/b&gt;&lt;br&gt;&lt;font color='#cc0000'&gt;GetRIMFaultInfoList&lt;/font&gt; → 仮値（NET0001/E10001）&lt;br&gt;count&amp;gt;0 で RAISED 固定 → Publish" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="485" width="290" height="95" as="geometry"/></mxCell><mxCell id="p3-WS_PUB" value="ws/*_publisher.c ＋ src/api_server_ws_publisher.c&lt;br&gt;（job / consumable は未使用）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="390" y="600" width="290" height="75" as="geometry"/></mxCell><mxCell id="p3-ING" value="ExternalRequestIngress/" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="720" y="275" width="400" height="450" as="geometry"/></mxCell><mxCell id="p3-ING_PD" value="&lt;b&gt;external_request_printdata_ingress.c&lt;/b&gt;&lt;br&gt;・