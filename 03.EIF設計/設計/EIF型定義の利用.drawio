color:#1D4ED8&#x27;&gt;読：EifApiServerConnector_Setup(), subscriptions_valid()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="312" width="500" height="66" as="geometry"/></mxCell><mxCell id="t4-6" value="&lt;b&gt;interval_ms&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;uint32_t&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;定期通知の周期[ms]（変化時は0）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：EifApiServerConnector_Setup(), subscriptions_valid()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="378" width="500" height="66" as="geometry"/></mxCell><mxCell id="t4-7" value="&lt;b&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書く機能&lt;/span&gt;&lt;/b&gt;（機能 → メンバー）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t4-8" value="&lt;b&gt;&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読む機能&lt;/span&gt;&lt;/b&gt;（メンバー → 機能）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1490" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t4-9" value="&lt;b&gt;書く機能は無い&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;初期値はソースの表で決まる（const）。&lt;br&gt;実行中は書き換えない&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="440" height="80" as="geometry"/></mxCell><mxCell id="t4-10" value="" style="html=1;edgeStyle=none;l