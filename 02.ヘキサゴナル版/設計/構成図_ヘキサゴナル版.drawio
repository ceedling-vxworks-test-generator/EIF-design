<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" pages="6"><diagram name="1.ヘキサゴナルとは" id="h1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h1-a1" value="&lt;b style='font-size:22px'&gt;ヘキサゴナルアーキテクチャ（Ports &amp;amp; Adapters）の基本形&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1220" height="50" as="geometry"/></mxCell><mxCell id="h1-a2" value="&lt;font color='#1D4ED8'&gt;◀ 使う側（ドライビング側）&lt;br&gt;コアに「お願い」をしてくる外の世界&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="420" height="50" as="geometry"/></mxCell><mxCell id="h1-a3" value="&lt;font color='#C2410C'&gt;使われる側（ドリブン側） ▶&lt;br&gt;コアが「お願い」をしに行く外の世界&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="420" height="50" as="geometry"/></mxCell><mxCell id="h1-CORE" value="&lt;b&gt;コア（中心）&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;direction=south;size=0.25;whiteSpace=wrap;html=1;fontSize=16;strokeWidth=3;fillColor=#DCFCE7;strokeColor=#16A34A;verticalAlign=top;spacingTop=40;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="400" height="460" as="geometry"/></mxCell><mxCell id="h1-a4" value="アプリの大事な処理だけを置く&lt;br&gt;外の世界のことは何も知らない" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontSize=14;" vertex="1" parent="1"><mxGeometry x="530" y="500" width="240" height="60" as="geometry"/></mxCell><mxCell id="h1-P1" value="入口ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="140" height="46" as="geometry"/></mxCell><mxCell id="h1-P2" value="入口ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="400" width="140" height="46" as="geometry"/></mxCell><mxCell id="h1-P3" value="出口ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="300" width="140" height="46" as="geometry"/></mxCell><mxCell id="h1-P4" value="出口ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="400" width="140" height="46" as="geometry"/></mxCell><mxCell id="h1-A1" value="&lt;b&gt;Webアダプタ&lt;/b&gt;&lt;br&gt;HTTP→コアの言葉" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="283" width="170" height="80" as="geometry"/></mxCell><mxCell id="h1-A2" value="&lt;b&gt;テスト用アダプタ&lt;/b&gt;&lt;br&gt;試験からコアを呼ぶ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="383" width="170" height="80" as="geometry"/></mxCell><mxCell id="h1-A3" value="&lt;b&gt;DBアダプタ&lt;/b&gt;&lt;br&gt;コアの言葉→SQL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="283" width="170" height="80" as="geometry"/></mxCell><mxCell id="h1-A4" value="&lt;b&gt;偽物アダプタ&lt;/b&gt;&lt;br&gt;試験用のDB代わり" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="383" width="170" height="80" as="geometry"/></mxCell><mxCell id="h1-E1" value="ブラウザ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="288" width="120" height="70" as="geometry"/></mxCell><mxCell id="h1-E2" value="テスト" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="388" width="120" height="70" as="geometry"/></mxCell><mxCell id="h1-E3" value="データベース" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1150" y="288" width="120" height="70" as="geometry"/></mxCell><mxCell id="h1-a5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-E1" target="h1-A1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-E2" target="h1-A2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-A1" target="h1-P1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-A2" target="h1-P2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-P3" target="h1-A3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a10" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-P4" target="h1-A4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-A3" target="h1-E3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a12" value="呼び出しの流れ：外 → アダプタ → ポート → コア → ポート → アダプタ → 外&lt;br&gt;コアが決めるのはポート（差込口の形）だけ。アダプタは何個でも、差し替えも自由" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontSize=16;" vertex="1" parent="1"><mxGeometry x="140" y="670" width="1020" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2.EIFのヘキサゴナル構成" id="h2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h2-a1" value="&lt;b style='font-size:22px'&gt;EIFをヘキサゴナルアーキテクチャで描くと&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1440" height="50" as="geometry"/></mxCell><mxCell id="h2-a2" value="&lt;font color='#1D4ED8'&gt;◀ 使う側：EIFに要求してくる相手&lt;br&gt;（接続相手が変わる → ここを足す）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="520" height="50" as="geometry"/></mxCell><mxCell id="h2-a3" value="&lt;font color='#C2410C'&gt;使われる側：EIFが呼びに行く相手 ▶&lt;br&gt;（機種が変わる → ここの対応表を足す）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="520" height="50" as="geometry"/></mxCell><mxCell id="h2-CORE" value="&lt;b&gt;EIF コア&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;direction=south;size=0.25;whiteSpace=wrap;html=1;fontSize=16;strokeWidth=3;fillColor=#DCFCE7;strokeColor=#16A34A;verticalAlign=top;spacingTop=40;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="460" height="560" as="geometry"/></mxCell><mxCell id="h2-a4" value="要求の受付&lt;br&gt;応答先の振り分け&lt;br&gt;情報の取得&lt;br&gt;設定のマージ&lt;br&gt;購読・差分の導出" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontSize=14;" vertex="1" parent="1"><mxGeometry x="670" y="300" width="160" height="140" as="geometry"/></mxCell><mxCell id="h2-a5" value="&lt;font color='#166534'&gt;PCL・REF・APIサーバー・&lt;br&gt;機種を知らない&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontSize=14;" vertex="1" parent="1"><mxGeometry x="630" y="560" width="240" height="50" as="geometry"/></mxCell><mxCell id="h2-LP" value="&lt;b&gt;公開ポート&lt;/b&gt;&lt;br&gt;&lt;br&gt;要求&lt;br&gt;情報&lt;br&gt;設定&lt;br&gt;通知&lt;br&gt;（完了・イベント）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="295" width="170" height="270" as="geometry"/></mxCell><mxCell id="h2-RP0" value="製品制御ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="170" height="44" as="geometry"/></mxCell><mxCell id="h2-RP1" value="システム情報ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="385" width="170" height="44" as="geometry"/></mxCell><mxCell id="h2-RP2" value="設定保存ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="470" width="170" height="44" as="geometry"/></mxCell><mxCell id="h2-LA0" value="&lt;b&gt;APIサーバー用アダプタ&lt;/b&gt;&lt;br&gt;REST / WebSocket" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="190" width="210" height="80" as="geometry"/></mxCell><mxCell id="h2-LE0" value="APIサーバー" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="150" height="60" as="geometry"/></mxCell><mxCell id="h2-a6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-LE0" target="h2-LA0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-LA0" target="h2-LP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-LA1" value="&lt;b&gt;PCIF用アダプタ&lt;/b&gt;&lt;br&gt;（将来）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;dashed=1;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="230" y="315" width="210" height="80" as="geometry"/></mxCell><mxCell id="h2-LE1" value="PCインタフェース" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="325" width="150" height="60" as="geometry"/></mxCell><mxCell id="h2-a8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;dashed=1;strokeColor=#94A3B8;" edge="1" parent="1" source="h2-LE1" target="h2-LA1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;dashed=1;strokeColor=#94A3B8;" edge="1" parent="1" source="h2-LA1" target="h2-LP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-LA2" value="&lt;b&gt;旧パネル用アダプタ&lt;/b&gt;&lt;br&gt;（将来）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;dashed=1;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="230" y="440" width="210" height="80" as="geometry"/></mxCell><mxCell id="h2-LE2" value="旧パネル" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="150" height="60" as="geometry"/></mxCell><mxCell id="h2-a10" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;dashed=1;strokeColor=#94A3B8;" edge="1" parent="1" source="h2-LE2" target="h2-LA2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;dashed=1;strokeColor=#94A3B8;" edge="1" parent="1" source="h2-LA2" target="h2-LP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-LA3" value="&lt;b&gt;テスト用アダプタ&lt;/b&gt;&lt;br&gt;試験からコアを呼ぶ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="565" width="210" height="80" as="geometry"/></mxCell><mxCell id="h2-LE3" value="単体試験" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="150" height="60" as="geometry"/></mxCell><mxCell id="h2-a12" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-LE3" target="h2-LA3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-LA3" target="h2-LP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-RA0" value="&lt;b&gt;PCLアダプタ&lt;/b&gt;&lt;br&gt;機種ごとの対応表" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFEDD5;strokeColo