ry></mxCell><mxCell id="o1-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;exitX=1.0000;exitY=0.2727;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2727;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1-I1" target="o1-A1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o1-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;exitX=0.0000;exitY=0.7727;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.7727;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1-A1" target="o1-I1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o1-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;exitX=1.0000;exitY=0.1538;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.1538;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1-I2" target="o1-A2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o1-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;exitX=0.0000;exitY=0.8846;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.8846;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1-A2" target="o1-I2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o1-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;exitX=1.0000;exitY=0.2727;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2727;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1-A1" target="o1-PCL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o1-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;exitX=0.0000;exitY=0.7727;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.7727;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1-PCL" target="o1-A1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o1-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;exitX=1.0000;exitY=0.1538;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.1538;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1-A2" target="o1-REF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o1-e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;exitX=0.0000;exitY=0.8846;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.8846;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1-REF" target="o1-A2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o1-e32" value="起動時：つなぐAccessorを指定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7C3AED;fontColor=#6D28D9;dashed=1;dashPattern=2 4;strokeWidth=2.5;endArrow=diamond;endFill=0;exitX=0.1373;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1-SET" target="o1-IFS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o1-e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7C3AED;fontColor=#6D28D9;dashed=1;dashPattern=2 4;strokeWidth=2.5;endArrow=diamond;endFill=0;exitX=0.6667;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1-SET" target="o1-ACC"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="o1-a34" value="&lt;b&gt;何が変わったら、どこを変えるか&lt;/b&gt;（どの場合も Frame は変えない）&lt;br&gt;・接続相手が増える・変わる → &lt;b&gt;connectors/&lt;/b&gt; に Connector を足す・直す&lt;br&gt;・機種が変わる → &lt;b&gt;accessors/pcl|ref/models/&amp;lt;MODEL&amp;gt;/&lt;/b&gt; の対応表と &lt;b&gt;setup/&amp;lt;MODEL&amp;gt;/&lt;/b&gt; を書く&lt;br&gt;・PCL・REFのAPIが変わる → &lt;b&gt;accessors/pcl/&lt;/b&gt;、&lt;b&gt;accessors/ref/&lt;/b&gt; の共通処理を直す&lt;br&gt;・設定の書込み先をPCL経由にする → &lt;b&gt;setup/&amp;lt;MODEL&amp;gt;/&lt;/b&gt; で設定保存IFにつなぐAccessorを替える（QA-01）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1830" height="150" as="geometry"/></mxCell><mxCell id="o1-a35" value="凡例" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;fillColor=#FFFFFF;strokeColor=#64748B;dashed=0;" vertex="1" parent="1"><mxGeometry x="1930" y="600" width="330" height="260" as="geometry"/></mxCell><mxCell id="o1-e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="653" as="sourcePoint"/><mxPoint x="2000" y="653" as="targetPoint"/></mxGeometry></mxCell><mxCell id="o1-a37" value="同期呼出し" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2010" y="640" width="240" height="26" as="geometry"/></mxCell><mxCell id="o1-e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="693" as="sourcePoint"/><mxPoint x="2000" y="693" as="targetPoint"/></mxGeometry></mxCell><mxCell id="o1-a39" value="非同期コールバック" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2010" y="680" width="240" height="26" as="geometry"/></mxCell><mxCell id="o1-e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7C3AED;fontColor=#6D28D9;dashed=1;dashPattern=2 4;strokeWidth=2.5;endArrow=diamond;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="733" as="sourcePoint"/><mxPoint x="2000" y="733" as="targetPoint"/></mxGeometry></mxCell><mxCell id="o1-a41" value="起動時の登録・指定" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2010" y="720" width="240" height="26" as="geometry"/></mxCell><mxCell id="o1-e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#94A3B8;dashed=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1950" y="773" as="sourcePoint"/><mxPoint x="2000" y="773" as="targetPoint"/></mxGeometry></mxCell><mxCell id="o1-a43" value="将来" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2010" y="760" width="240" height="26" as="geometry"/></mxCell><mxCell id="o1-a44" value="部品と関数の詳細は「2.詳細ブロック図」、&lt;br&gt;呼出しと戻りは「3〜5.関係図」" style="text;html=1;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1950" y="800" width="300" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2.詳細ブロック図" id="o2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="o2-a1" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;詳細ブロック図&lt;/b&gt;&lt;/font&gt;　　Connector・Frame・Accessorの部品と主要関数まで。横の並びが1つの処理" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1800" height="40" as="geometry"/></mxCell><mxCell id="o2-COMP" value="&lt;b&gt;setup/MiniPrinter/　機種セットアップ&lt;/b&gt;　EIF_Setup()：EIF_Frame_Initialize(&amp;amp;acc)&lt;br&gt;acc = { .control=&amp;amp;g_pcl_control_if, .info=&amp;amp;g_ref_info_if, .setting=&amp;amp;g_ref_setting_if }　← 設定の書込み先を変えるならここ（QA-01）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="50" width="1320" height="70" as="geometry"/></mxCell><mxCell id="o2-EXT" value="外部コンポーネント&lt;br&gt;APIサーバー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;fillColor=#F1F5F9;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="240" height="920" as="geometry"/></mxCell><mxCell id="o2-X_REST" value="&lt;b&gt;REST処理&lt;/b&gt;&lt;br&gt;（OpenAPI）&lt;br&gt;&lt;br&gt;[C2] blocking&lt;br&gt;スレッド群から&lt;br&gt;callbackを呼ぶ&lt;br&gt;&lt;br&gt;複数要求が&lt;br&gt;同時に来る" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="200" height="470" as="geometry"/></mxCell><mxCell id="o2-X_WS" value="&lt;b&gt;WebSocket配信&lt;/b&gt;&lt;br&gt;server_ws_emit_event()&lt;br&gt;コピーして即復帰" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="200" height="110" as="geometry"/></mxCell><mxCell id="o2-a2" value="&lt;b&gt;将来&lt;/b&gt;：PCインタフェース／旧パネル → connectors/ にConnectorを1つ足すだけ（Frameは変えない）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#F1F5F9;strokeColor=#64748B;dashed=1;fontColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="690" height="70" as="geometry"/></mxCell><mxCell id="o2-DRV" value="connectors/api_server/&lt;br&gt;Connector（外部コンポーネント接続部）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="320" y="160" width="420" height="920" as="geometry"/></mxCell><mxCell id="o2-A_ENT" value="&lt;b&gt;EifApiServerConnector_Setup()&lt;/b&gt; [C1]&lt;br&gt;① EIF_RegisterConnector()&lt;br&gt;② server_rest_register_callbacks()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="205" width="380" height="85" as="geometry"/></mxCell><mxCell id="o2-A_JOB" value="&lt;b&gt;rest_jobs_create() / 取消&lt;/b&gt; [C2]&lt;br&gt;job_type → 公開要求ID（8種）&lt;br&gt;→ EIF_SubmitRequest()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="340" width="380" height="90" as="geometry"/></mxCell><mxCell id="o2-A_DONE" value="&lt;b&gt;on_request_completed()&lt;/b&gt; [C3]&lt;br&gt;結果 → job completed／error／canceled&lt;br&gt;→ server_ws_emit_event()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="450" width="380" height="90" as="geometry"/></mxCell><mxCell id="o2-A_SET" value="&lt;b&gt;rest_patch_network()&lt;/b&gt; [C2]&lt;br&gt;→ EIF_PatchSetting()&lt;br&gt;EIF_ACCEPTED（PCL経由）なら&lt;br&gt;token で完了を待つ（上限5秒）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="560" width="380" height="100" as="geometry"/></mxCell><mxCell id="o2-A_GET" value="&lt;b&gt;rest_get_network()&lt;/b&gt; [C2]&lt;br&gt;→ EIF_GetInfo()&lt;br&gt;公開モデル → APIサーバー型&lt;br&gt;EIF_Result → uc_result_t" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="690" width="380" height="100" as="geometry"/></mxCell><mxCell id="o2-A_EVT" value="&lt;b&gt;on_event()&lt;/b&gt; [C4]&lt;br&gt;error raised／resolved&lt;br&gt;→ server_ws_emit_event()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="840" width="380" height="110" as="geometry"/></mxCell><mxCell id="o2-a3" value="APIサーバーのヘッダーを参照してよいのは&lt;br&gt;このフォルダだけ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=none;strokeColor=none;fontColor=#1D4ED8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="970" width="380" height="90" as="geometry"/></mxCell><mxCell id="o2-HEX" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#F0FDF4;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="970" y