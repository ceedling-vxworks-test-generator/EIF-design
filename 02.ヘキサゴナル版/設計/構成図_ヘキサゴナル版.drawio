<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" pages="7"><diagram name="1.ヘキサゴナルとは" id="h1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h1-a1" value="&lt;b style='font-size:22px'&gt;ヘキサゴナルアーキテクチャ（Ports &amp;amp; Adapters）の基本形&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1220" height="50" as="geometry"/></mxCell><mxCell id="h1-a2" value="&lt;font color='#1D4ED8'&gt;◀ 使う側（ドライビング側）&lt;br&gt;コアに「お願い」をしてくる外の世界&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="420" height="50" as="geometry"/></mxCell><mxCell id="h1-a3" value="&lt;font color='#C2410C'&gt;使われる側（ドリブン側） ▶&lt;br&gt;コアが「お願い」をしに行く外の世界&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="420" height="50" as="geometry"/></mxCell><mxCell id="h1-CORE" value="&lt;b&gt;コア（中心）&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;direction=south;size=0.25;whiteSpace=wrap;html=1;fontSize=16;strokeWidth=3;fillColor=#DCFCE7;strokeColor=#16A34A;verticalAlign=top;spacingTop=40;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="400" height="460" as="geometry"/></mxCell><mxCell id="h1-a4" value="アプリの大事な処理だけを置く&lt;br&gt;外の世界のことは何も知らない" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontSize=14;" vertex="1" parent="1"><mxGeometry x="530" y="500" width="240" height="60" as="geometry"/></mxCell><mxCell id="h1-P1" value="入口ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="140" height="46" as="geometry"/></mxCell><mxCell id="h1-P2" value="入口ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="400" width="140" height="46" as="geometry"/></mxCell><mxCell id="h1-P3" value="出口ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="300" width="140" height="46" as="geometry"/></mxCell><mxCell id="h1-P4" value="出口ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="400" width="140" height="46" as="geometry"/></mxCell><mxCell id="h1-A1" value="&lt;b&gt;Webアダプタ&lt;/b&gt;&lt;br&gt;HTTP→コアの言葉" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="283" width="170" height="80" as="geometry"/></mxCell><mxCell id="h1-A2" value="&lt;b&gt;テスト用アダプタ&lt;/b&gt;&lt;br&gt;試験からコアを呼ぶ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="383" width="170" height="80" as="geometry"/></mxCell><mxCell id="h1-A3" value="&lt;b&gt;DBアダプタ&lt;/b&gt;&lt;br&gt;コアの言葉→SQL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="283" width="170" height="80" as="geometry"/></mxCell><mxCell id="h1-A4" value="&lt;b&gt;偽物アダプタ&lt;/b&gt;&lt;br&gt;試験用のDB代わり" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="383" width="170" height="80" as="geometry"/></mxCell><mxCell id="h1-E1" value="ブラウザ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="288" width="120" height="70" as="geometry"/></mxCell><mxCell id="h1-E2" value="テスト" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="388" width="120" height="70" as="geometry"/></mxCell><mxCell id="h1-E3" value="データベース" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1150" y="288" width="120" height="70" as="geometry"/></mxCell><mxCell id="h1-a5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-E1" target="h1-A1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-E2" target="h1-A2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-A1" target="h1-P1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-A2" target="h1-P2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-P3" target="h1-A3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a10" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-P4" target="h1-A4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h1-A3" target="h1-E3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h1-a12" value="呼び出しの流れ：外 → アダプタ → ポート → コア → ポート → アダプタ → 外&lt;br&gt;コアが決めるのはポート（差込口の形）だけ。アダプタは何個でも、差し替えも自由" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontSize=16;" vertex="1" parent="1"><mxGeometry x="140" y="670" width="1020" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2.EIFのヘキサゴナル構成" id="h2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h2-a1" value="&lt;b style='font-size:22px'&gt;EIFをヘキサゴナルアーキテクチャで描くと&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1440" height="50" as="geometry"/></mxCell><mxCell id="h2-a2" value="&lt;font color='#1D4ED8'&gt;◀ 使う側：EIFに要求してくる相手&lt;br&gt;（接続相手が変わる → ここを足す）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="520" height="50" as="geometry"/></mxCell><mxCell id="h2-a3" value="&lt;font color='#C2410C'&gt;使われる側：EIFが呼びに行く相手 ▶&lt;br&gt;（機種が変わる → ここの対応表を足す）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="520" height="50" as="geometry"/></mxCell><mxCell id="h2-CORE" value="&lt;b&gt;EIF コア&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;direction=south;size=0.25;whiteSpace=wrap;html=1;fontSize=16;strokeWidth=3;fillColor=#DCFCE7;strokeColor=#16A34A;verticalAlign=top;spacingTop=40;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="460" height="560" as="geometry"/></mxCell><mxCell id="h2-a4" value="要求の受付&lt;br&gt;応答先の振り分け&lt;br&gt;情報の取得&lt;br&gt;設定のマージ&lt;br&gt;購読・差分の導出" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontSize=14;" vertex="1" parent="1"><mxGeometry x="670" y="300" width="160" height="140" as="geometry"/></mxCell><mxCell id="h2-a5" value="&lt;font color='#166534'&gt;PCL・REF・APIサーバー・&lt;br&gt;機種を知らない&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontSize=14;" vertex="1" parent="1"><mxGeometry x="630" y="560" width="240" height="50" as="geometry"/></mxCell><mxCell id="h2-LP" value="&lt;b&gt;公開ポート&lt;/b&gt;&lt;br&gt;&lt;br&gt;要求&lt;br&gt;情報&lt;br&gt;設定&lt;br&gt;通知&lt;br&gt;（完了・イベント）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="295" width="170" height="270" as="geometry"/></mxCell><mxCell id="h2-RP0" value="製品制御ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="170" height="44" as="geometry"/></mxCell><mxCell id="h2-RP1" value="システム情報ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="385" width="170" height="44" as="geometry"/></mxCell><mxCell id="h2-RP2" value="設定保存ポート" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="470" width="170" height="44" as="geometry"/></mxCell><mxCell id="h2-LA0" value="&lt;b&gt;APIサーバー用アダプタ&lt;/b&gt;&lt;br&gt;REST / WebSocket" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="190" width="210" height="80" as="geometry"/></mxCell><mxCell id="h2-LE0" value="APIサーバー" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="150" height="60" as="geometry"/></mxCell><mxCell id="h2-a6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-LE0" target="h2-LA0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-LA0" target="h2-LP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-LA1" value="&lt;b&gt;PCIF用アダプタ&lt;/b&gt;&lt;br&gt;（将来）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;dashed=1;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="230" y="315" width="210" height="80" as="geometry"/></mxCell><mxCell id="h2-LE1" value="PCインタフェース" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="325" width="150" height="60" as="geometry"/></mxCell><mxCell id="h2-a8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;dashed=1;strokeColor=#94A3B8;" edge="1" parent="1" source="h2-LE1" target="h2-LA1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;dashed=1;strokeColor=#94A3B8;" edge="1" parent="1" source="h2-LA1" target="h2-LP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-LA2" value="&lt;b&gt;旧パネル用アダプタ&lt;/b&gt;&lt;br&gt;（将来）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;dashed=1;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="230" y="440" width="210" height="80" as="geometry"/></mxCell><mxCell id="h2-LE2" value="旧パネル" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="150" height="60" as="geometry"/></mxCell><mxCell id="h2-a10" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;dashed=1;strokeColor=#94A3B8;" edge="1" parent="1" source="h2-LE2" target="h2-LA2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;dashed=1;strokeColor=#94A3B8;" edge="1" parent="1" source="h2-LA2" target="h2-LP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-LA3" value="&lt;b&gt;テスト用アダプタ&lt;/b&gt;&lt;br&gt;試験からコアを呼ぶ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="565" width="210" height="80" as="geometry"/></mxCell><mxCell id="h2-LE3" value="単体試験" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="150" height="60" as="geometry"/></mxCell><mxCell id="h2-a12" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-LE3" target="h2-LA3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-LA3" target="h2-LP"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-RA0" value="&lt;b&gt;PCLアダプタ&lt;/b&gt;&lt;br&gt;機種ごとの対応表" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="190" width="230" height="80" as="geometry"/></mxCell><mxCell id="h2-RE0" value="PCL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFF2CC;strokeColor=#B45309;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="200" width="130" height="60" as="geometry"/></mxCell><mxCell id="h2-a14" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-RP0" target="h2-RA0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-RA0" target="h2-RE0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-RA1" value="&lt;b&gt;REFアダプタ&lt;/b&gt;&lt;br&gt;機種ごとの対応表・型変換" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="360" width="230" height="80" as="geometry"/></mxCell><mxCell id="h2-RE1" value="REF（RIM）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFF2CC;strokeColor=#B45309;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="370" width="130" height="60" as="geometry"/></mxCell><mxCell id="h2-a16" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-RP1" target="h2-RA1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-RA1" target="h2-RE1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-RA2" value="&lt;b&gt;REF書込みアダプタ&lt;/b&gt;&lt;br&gt;※PCL経由へ差し替え可" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="530" width="230" height="80" as="geometry"/></mxCell><mxCell id="h2-RE2" value="REF（RIM）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFF2CC;strokeColor=#B45309;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="540" width="130" height="60" as="geometry"/></mxCell><mxCell id="h2-a18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-RP2" target="h2-RA2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" parent="1" source="h2-RA2" target="h2-RE2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="h2-a20" value="&lt;b&gt;テスト用の偽物アダプタ&lt;/b&gt;&lt;br&gt;PCL・REFの代わり" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1090" y="700" width="230" height="70" as="geometry"/></mxCell><mxCell id="h2-a21" value="接続相手が増える → 左にアダプタを足す　｜　機種が変わる → 右のアダプタの対応表を足す&lt;br&gt;設定の書込み先をPCL経由にする → 右のアダプタを差し替える　｜　&lt;b&gt;どの場合もコアは変えない&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="230" y="800" width="1100" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.詳細ブロック図" id="hb"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="hb-a1" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;詳細ブロック図（ヘキサゴナル版）&lt;/b&gt;&lt;/font&gt;　　アダプタ・ポート・コアの部品と主要関数まで。横の並びが1つの処理" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1800" height="40" as="geometry"/></mxCell><mxCell id="hb-COMP" value="&lt;b&gt;composition/MiniPrinter/　組立て&lt;/b&gt;　EIF_Setup()：EIF_Core_Initialize(&amp;amp;ports)&lt;br&gt;ports = { .control=&amp;amp;g_pcl_control_port, .info=&amp;amp;g_ref_info_port, .setting=&amp;amp;g_ref_setting_port }　← 設定の書込み先を変えるならここ（QA-01）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="50" width="1320" height="70" as="geometry"/></mxCell><mxCell id="hb-EXT" value="外部コンポーネント&lt;br&gt;APIサーバー" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;fillColor=#F1F5F9;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="240" height="920" as="geometry"/></mxCell><mxCell id="hb-X_REST" value="&lt;b&gt;REST処理&lt;/b&gt;&lt;br&gt;（OpenAPI）&lt;br&gt;&lt;br&gt;[C2] blocking&lt;br&gt;スレッド群から&lt;br&gt;callbackを呼ぶ&lt;br&gt;&lt;br&gt;複数要求が&lt;br&gt;同時に来る" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="200" height="470" as="geometry"/></mxCell><mxCell id="hb-X_WS" value="&lt;b&gt;WebSocket配信&lt;/b&gt;&lt;br&gt;server_ws_emit_event()&lt;br&gt;コピーして即復帰" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="200" height="110" as="geometry"/></mxCell><mxCell id="hb-a2" value="&lt;b&gt;将来&lt;/b&gt;：PCインタフェース／旧パネル → adapters/driving/ に使う側のアダプタを1つ足すだけ（コアは変えない）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#F1F5F9;strokeColor=#64748B;dashed=1;fontColor=#475569;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="690" height="70" as="geometry"/></mxCell><mxCell id="hb-DRV" value="adapters/driving/api_server/&lt;br&gt;使う側のアダプタ" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="320" y="160" width="420" height="920" as="geometry"/></mxCell><mxCell id="hb-A_ENT" value="&lt;b&gt;EifApiServerConnector_Setup()&lt;/b&gt; [C1]&lt;br&gt;① EIF_RegisterConnector()&lt;br&gt;② server_rest_register_callbacks()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="205" width="380" height="85" as="geometry"/></mxCell><mxCell id="hb-A_JOB" value="&lt;b&gt;rest_jobs_create() / 取消&lt;/b&gt; [C2]&lt;br&gt;job_type → 公開要求ID（8種）&lt;br&gt;→ EIF_SubmitRequest()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="340" width="380" height="90" as="geometry"/></mxCell><mxCell id="hb-A_DONE" value="&lt;b&gt;on_request_completed()&lt;/b&gt; [C3]&lt;br&gt;結果 → job completed／error／canceled&lt;br&gt;→ server_ws_emit_event()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="450" width="380" height="90" as="geometry"/></mxCell><mxCell id="hb-A_SET" value="&lt;b&gt;rest_patch_network()&lt;/b&gt; [C2]&lt;br&gt;→ EIF_PatchSetting()&lt;br&gt;EIF_ACCEPTED（PCL経由）なら&lt;br&gt;token で完了を待つ（上限5秒）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="560" width="380" height="100" as="geometry"/></mxCell><mxCell id="hb-A_GET" value="&lt;b&gt;rest_get_network()&lt;/b&gt; [C2]&lt;br&gt;→ EIF_GetInfo()&lt;br&gt;公開モデル → APIサーバー型&lt;br&gt;EIF_Result → uc_result_t" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="690" width="380" height="100" as="geometry"/></mxCell><mxCell id="hb-A_EVT" value="&lt;b&gt;on_event()&lt;/b&gt; [C4]&lt;br&gt;error raised／resolved&lt;br&gt;→ server_ws_emit_event()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="340" y="840" width="380" height="110" as="geometry"/></mxCell><mxCell id="hb-a3" value="APIサーバーのヘッダーを参照してよいのは&lt;br&gt;このフォルダだけ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=none;strokeColor=none;fontColor=#1D4ED8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="970" width="380" height="90" as="geometry"/></mxCell><mxCell id="hb-HEX" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#F0FDF4;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="870" y="140" width="1100" height="960" as="geometry"/></mxCell><mxCell id="hb-a4" value="&lt;b&gt;core/　EIFコア&lt;/b&gt;：PCL・REF・APIサーバー・機種を知らない（公開ID・公開モデルだけで動く）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontColor=#166534;" vertex="1" parent="1"><mxGeometry x="990" y="1040" width="730" height="40" as="geometry"/></mxCell><mxCell id="hb-K_REG" value="&lt;b&gt;connector/&lt;/b&gt; ConnectorRegistry&lt;br&gt;EIF_RegisterConnector()&lt;br&gt;最大4件・Start後は不変&lt;br&gt;受信フィルタ（ビット列）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="990" y="180" width="300" height="110" as="geometry"/></mxCell><mxCell id="hb-K_CORE" value="&lt;b&gt;core/&lt;/b&gt; eif_core.c&lt;br&gt;EIF_Core_Initialize(&amp;amp;ports)：ポートの検証&lt;br&gt;EIF_Start()：watch開始・受付開始&lt;br&gt;set_done_handler(eif_tracker_on_done)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="1420" y="180" width="300" height="110" as="geometry"/></mxCell><mxCell id="hb-K_GW" value="&lt;b&gt;request/&lt;/b&gt; RequestGateway&lt;br&gt;EIF_SubmitRequest() / Cancel / GetRequestResult&lt;br&gt;公開範囲＝control-&amp;gt;is_supported()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#DCFCE7;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="990" y="340" width="300" height="90" as="geometry"/></mxCell><mxCell id="hb-K_TR" value="&lt;b&gt;request/&lt;/b&gt; RequestTracker（台帳40件）&lt;br&gt;ticket ⇔ handle・要求元・token&lt;br&gt;eif_tracker_on_done() [C3]・先着完了" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#DCFCE7;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="990" y="450" width="300" height="90" as="geometry"/></mxCell><mxCell id="hb-K_SM" value="&lt;b&gt;setting/&lt;/b&gt; SettingMerger&lt;br&gt;EIF_PatchSetting()&lt;br&gt;現在値（2KB）＋パッチ → 合成（2KB）&lt;br&gt;公開モデル上でマージ（機種非依存）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#DCFCE7;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="990" y="560" width="300" height="100" as="geometry"/></mxCell><mxCell id="hb-K_IR" value="&lt;b&gt;info/&lt;/b&gt; InfoReader&lt;br&gt;EIF_GetInfo()&lt;br&gt;public_size() でサイズ検証&lt;br&gt;→ info-&amp;gt;read()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#DCFCE7;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="990" y="690" width="300" height="100" as="geometry"/></mxCell><mxCell id="hb-K_ED" value="&lt;b&gt;notify/&lt;/b&gt; EventDispatcher&lt;br&gt;eif_dispatch_event()&lt;br&gt;Registryの受信フィルタに一致する&lt;br&gt;Connectorへ登録順に配信（キューなし）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#DCFCE7;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="990" y="840" width="300" height="110" as="geometry"/></mxCell><mxCell id="hb-K_WT" value="&lt;b&gt;notify/&lt;/b&gt; Watcher&lt;br&gt;通知定義表 k_watch（ALARM_LIST→発生／解消）&lt;br&gt;on_info_changed() [C4]&lt;br&gt;一覧の差分（キー＝alarm_id）→ 最大8件" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#DCFCE7;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="1420" y="840" width="300" height="110" as="geometry"/></mxCell><mxCell id="hb-K_SC" value="&lt;b&gt;cache/&lt;/b&gt; StateCache　前回値 4KB／8スロット&lt;br&gt;EIFでデータを持つのはここだけ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="1420" y="970" width="300" height="70" as="geometry"/></mxCell><mxCell id="hb-a5" value