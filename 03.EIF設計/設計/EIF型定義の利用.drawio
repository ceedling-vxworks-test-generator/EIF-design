nt-size:10px&#x27;&gt;EIF_Setup&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t9-28" value="&lt;b&gt;② Connector登録&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_RegisterConnector&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="276" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t9-29" value="&lt;b&gt;③ 開始&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Start&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="512" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t9-30" value="&lt;b&gt;④ 要求受付&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_SubmitRequest／&lt;br&gt;CancelRequest／GetRequestResult&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="749" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t9-31" value="&lt;b&gt;⑤ 完了通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;PCLの完了 → on_request_completed&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="985" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t9-32" value="&lt;b&gt;⑥ 情報取得&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_GetInfo&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1221" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t9-33" value="&lt;b&gt;⑦ 設定変更&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_PatchSetting&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#1D4ED8&#x27;&gt;読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_PatchSetting()（マージ）&lt;br&gt;EIF_PatchSetting()（受付）&lt;br&gt;EIF_PatchSetting()（現在値の取得）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1458" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t9-34" value="&lt;b&gt;⑧ イベント通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REFの通知 → on_event&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1694" y="634" width="228" height="116" as="geometry"/></mxCell><mxCell id="t9-35" value="メンバーの行：白＝どこかの機能が使う、灰色＝今の実装では読み書きする機能が無い。線の色は機能ごと。タイミングの番号は ① 起動 ② Connector登録 ③ 開始 ④ 要求受付 ⑤ 完了通知 ⑥ 情報取得 ⑦ 設定変更 ⑧ イベント通知" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1890" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.2.5 EIF_AccessorSet" id="t10"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t10-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;3.2.5 EIF_AccessorSet（下位IF）（下位IF一式）&lt;/b&gt;&lt;/font&gt;　　" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="t10-2" value="&lt;b&gt;概要&lt;/b&gt;　Frame が PCL・REF を使うときの呼出し口。Frame が定義し、Accessor が実装し、機種セットアップが渡す（← 3.3.6）&lt;br&gt;&lt;b&gt;置き場所&lt;/b&gt;　frame/include/eif_accessor_if.h（型）・frame/core/eif_frame.c（s_accessors に保持）　（部品：Frame）&lt;br&gt;&lt;b&gt;書き換わる時期&lt;/b&gt;　起動時（EIF_Frame_Initialize）に保持し、以降は不変" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;fillColor=#F0FDF4;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1890" height="96" as="geometry"/></mxCell><mxCell id="t10-3" value="&lt;b&gt;EIF_AccessorSet（下位IF）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;下位IF一式（3.2.5）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E0F2FE;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="190" width="500" height="56" as="geometry"/></mxCell><mxCell id="t10-4" value="&lt;b&gt;control&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;const EIF_ProductControlIf *&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;製品制御IF：is_supported, submit, cancel, query, set_done_handler&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：EIF_Frame_Initialize()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：EIF_Frame_Initialize(), EIF_SubmitRequest()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="246" width="500" height="66" as="geometry"/></mxCell><mxCell id="t10-5" value="&lt;b&gt;info&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;const EIF_SystemInfoIf *&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;システム情報IF：is_supported, public_size, read, is_event_supported, watch_event&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：EIF_Frame_Initialize()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：eif_watcher_start(), EIF_GetInfo(), EIF_PatchSetting()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="312" width="500" height="66" as="geometry"/></mxCell><mxCell id="t10-6" value="&lt;b&gt;setting&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;const EIF_SettingStoreIf *&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;設定保存IF：is_supported, store&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：EIF_Frame_Initialize()&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：EIF_PatchSetting()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="378" width="500" height="66" as="geometry"/></mxCell><mxCell id="t10-7" value="&lt;b&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書く機能&lt;/span&gt;&lt;/b&gt;（機能 → メンバー）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t10-8" value="&lt;b&gt;&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読む機能&lt;/span&gt;&lt;/b&gt;（メンバー → 機能）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1490" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t10-9" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;① 起動&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.2.1&lt;/span&gt;&lt;br&gt;&lt;b&gt;EIF_Frame_Initialize()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#C2410C;padding:0 3px;font-weight:bold&#x27;&gt;書&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;control, info, setting&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;全関数がそろっているかを確かめて保持する。そろっていなければ EIF_ERR_INVALID_CONFIG&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="440" height="91" as="geometry"/></mxCell><mxCell id="t10-10" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.250;entryX=0;entryY=0.5;" edge="1" parent="1" source="t10-9" target="t10-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t10-11" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.500;entryX=0;entryY=0.5;" edge="1" parent="1" source="t10-9" target="t10-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t10-12" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.750;entryX=0;entryY=0.5;" edge="1" parent="1" source="t10-9" target="t10-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t10-13" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;① 起動&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.2.1&lt;/span&gt;&lt;br&gt;&lt;b&gt;EIF_Frame_Initialize()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;control&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;control→set_done_handler(eif_tracker_on_done) で完了の受け口を渡す&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="190" width="440" height="91" as="geometry"/></mxCell><mxCell id="t10-14" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t10-4" target="t10-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t10-15" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;③ 開始&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.2.8&lt;/span&gt;&lt;br&gt;&lt;b&gt;eif_watcher_start()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;info&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;info→is_event_supported、info→watch_event&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#C2410C;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="303" width="440" height="91" as="geometry"/></mxCell><mxCell id="t10-16" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#C2410C;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t10-5" target="t10-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t10-17" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;④ 要求受付&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.2.2&lt;/span&gt;&lt;br&gt;&lt;b&gt;EIF_SubmitRequest()／Cancel／GetRequestResult&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;control&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;control→is_supported、submit、cancel、query&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="416" width="440" height="91" as="geometry"/></mxCell><mxCell id="t10-18" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#15803D;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t10-4" target="t10-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t10-19" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑥ 情報取得&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.2.6&lt;/span&gt;&lt;br&gt;&lt;b&gt;EIF_GetInfo()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;info&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;info→is_supported、public_size、read&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="529" width="440" height="76" as="geometry"/></mxCell><mxCell id="t10-20" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t10-5" target="t10-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t10-21" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑦ 設定変更&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.2.7&lt;/span&gt;&lt;br&gt;&lt;b&gt;EIF_PatchSetting()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;setting, info&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;setting→is_supported、store。info→is_supported、read（現在値）&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="627" width="440" height="91" as="geometry"/></mxCell><mxCell id="t10-22" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#DB2777;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.333;" edge="1" parent="1" source="t10-6" target="t10-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t10-23" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#DB2777;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.667;" edge="1" parent="1" source="t10-5" target="t10-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t10-24" value="&lt;b&gt;使われるタイミング&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="400" height="24" as="geometry"/></mxCell><mxCell id="t10-25" value="&lt;b&gt;① 起動&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Setup&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#C2410C&#x27;&gt;書く・読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Frame_Initialize()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="798" width="228" height="116" as="geometry"/></mxCell><mxCell id="t10-26" value="&lt;b&gt;② Connector登録&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_RegisterConnector&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="276" y="798" width="228" height="116" as="geometry"/></mxCell><mxCell id="t10-27" value="&lt;b&gt;③ 開始&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_Start&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#1D4ED8&#x27;&gt;読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;eif_watcher_start()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="512" y="798" width="228" height="116" as="geometry"/></mxCell><mxCell id="t10-28" value="&lt;b&gt;④ 要求受付&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_SubmitRequest／&lt;br&gt;CancelRequest／GetRequestResult&lt;/span&gt;&lt;br&gt;&lt;b 