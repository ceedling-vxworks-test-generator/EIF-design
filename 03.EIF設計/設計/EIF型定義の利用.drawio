FFFF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="444" width="500" height="66" as="geometry"/></mxCell><mxCell id="t9-8" value="&lt;b&gt;merge_func&lt;/b&gt;　&lt;span style=&#x27;color:#475569&#x27;&gt;MergeFunction&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;現在値＋パッチ → 合成結果（has_xxx の項目だけ上書き）&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書：－&lt;/span&gt;　&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読：EIF_PatchSetting()&lt;/span&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="510" width="500" height="66" as="geometry"/></mxCell><mxCell id="t9-9" value="&lt;b&gt;&lt;span style=&#x27;color:#C2410C&#x27;&gt;書く機能&lt;/span&gt;&lt;/b&gt;（機能 → メンバー）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t9-10" value="&lt;b&gt;&lt;span style=&#x27;color:#1D4ED8&#x27;&gt;読む機能&lt;/span&gt;&lt;/b&gt;（メンバー → 機能）" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1490" y="160" width="440" height="24" as="geometry"/></mxCell><mxCell id="t9-11" value="&lt;b&gt;書く機能は無い&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;初期値はソースの表で決まる（const）。&lt;br&gt;実行中は書き換えない&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;dashed=1;fillColor=#F8FAFC;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="440" height="80" as="geometry"/></mxCell><mxCell id="t9-12" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=open;dashed=1;strokeColor=#CBD5E1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="t9-11" target="t9-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCe