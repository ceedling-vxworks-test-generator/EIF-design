ize=10;" vertex="1" parent="1"><mxGeometry x="770" y="434" width="450" height="24" as="geometry"/></mxCell><mxCell id="q6-a32" value="行の source を RefPort.get_binary で取得＋サイズ検証" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="464" width="450" height="24" as="geometry"/></mxCell><mxCell id="q6-a33" value="行の convert を呼ぶ／結果コード変換（16章）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="494" width="450" height="24" as="geometry"/></mxCell><mxCell id="q6-a34" value="製品CFG：MiniPrinter（機種ごと）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="404" width="490" height="126" as="geometry"/></mxCell><mxCell id="q6-a35" value="InfoMap1行：{ EIF_INFO_NETWORK_SETTINGS, {NETWORK_INFO, HOSTNAME, MACADDRESS}, mp_convert_network_settings }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="434" width="470" height="46" as="geometry"/></mxCell><mxCell id="q6-a36" value="mp_convert_network_settings：RIM_network_info_t → 公開モデル（現行の変換関数を移設）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="486" width="470" height="34" as="geometry"/></mxCell><mxCell id="q6-a37" value="Connector（api_server）：公開モデル → network_settings_t の詰め替えのみ（全機種共通）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="528" width="980" height="26" as="geometry"/></mxCell><mxCell id="q6-a38" value="分割" style="shape=flexArrow;endArrow=classic;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="688" y="474" as="sourcePoint"/><mxPoint x="752" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q6-a39" value="&lt;b&gt;例3：製品要求（REST POST /jobs）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=12;fillColor=#eeeeee;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="1700" height="24" as="geometry"/></mxCell><mxCell id="q6-a40" value="rest/jobs.c ＋ external_request_ingress.c（未接続）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="618" width="640" height="154" as="geometry"/></mxCell><mxCell id="q6-a41" value="switch(job_type) { JOB_TYPE_PRINT → PCL_JOB_TYPE_PRINT … }（公開範囲と対応がコード）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="648" width="620" height="24" as="geometry"/></mxCell><mxCell id="q6-a42" value="未公開の要求は UC_ERR_NOT_IMPLEMENTED を返すスタブ関数で表現" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="678" width="620" height="24" as="geometry"/></mxCell><mxCell id="q6-a43" value="（未実装）PCL Submit・完了callback・相関" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="708" width="620" height="24" as="geometry"/></mxCell><mxCell id="q6-a44" value="job_create_request_t / accepted_job_t を直接扱う" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="738" width="620" height="24" as="geometry"/></mxCell><mxCell id="q6-a45" value="Frame：RequestGateway / RequestTracker（全機種共通）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#eef7e8;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="618" width="470" height="124" as="geometry"/></mxCell><mxCell id="q6-a46" value="公開要求IDで RequestMap を検索（無ければ NOT_EXPOSED）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="648" width="450" height="24" as="geometry"/></mxCell><mxCell id="q6-a47" value="build_params → PclPort.submit(…, 完了トランポリン)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="678" width="450" height="24" as="geometry"/></mxCell><mxCell id="q6-a48" value="要求ハンドル払い出し・相関・先着完了・完了イベント配信" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="708" width="450" height="24" as="geometry"/></mxCell><mxCell id="q6-a49" value="製品CFG：MiniPrinter（機種ごと）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="618" width="490" height="116" as="geometry"/></mxCell><mxCell id="q6-a50" value="RequestMap：{ EIF_REQ_HEAD_CLEANING, PRODUCT_REQUEST_ID_NORMAL_PURGE_ALL, sizeof(param), mp_build_head_cleaning } …" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="648" width="470" height="46" as="geometry"/></mxCell><mxCell id="q6-a51" value="mp_build_head_cleaning：公開パラメータ → 製品要求パラメータ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="700" width="470" height="24" as="geometry"/></mxCell><mxCell id="q6-a52" value="Connector（api_server）：job_type → 公開要求ID、要求ハンドル → job_id 文字列（全機種共通）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="742" width="980" height="26" as="geometry"/></mxCell><mxCell id="q6-a53" value="分割" style="shape=flexArrow;endArrow=classic;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="688" y="688" as="sourcePoint"/><mxPoint x="752" y="688" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q6-a54" value="&lt;b&gt;現行：次機種で変更が必要な範囲&lt;/b&gt;&lt;br&gt;・rest/*.c、ws/*.c、ExternalRequestIngress/*.c のほぼ全体（赤の行が全ファイルに散在）&lt;br&gt;・CMakeLists.txt（include/MiniPrinter の参照）&lt;br&gt;・PCL の StartUp（EIFの初期化を持っているため）&lt;br&gt;→ &lt;b&gt;実質的にEIFの作り直し&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="802" width="640" height="150" as="geometry"/></mxCell><mxCell id="q6-a55" value="&lt;b&gt;改善後：次機種で変更が必要な範囲&lt;/b&gt;&lt;br&gt;・product/&amp;lt;MODEL&amp;gt;/ の表と変換関数&lt;b&gt;だけ&lt;/b&gt;（Skeletonをコピーして作成）&lt;br&gt;・Frame・Connector・公開APIは変更しない（公開ID・公開モデル自体が増える場合のみ 公開APIとConnectorに追記）&lt;br&gt;・変換関数は純粋関数なので、REF・PCL・APIサーバー無しで単体試験できる&lt;br&gt;・Frame の CMake に REF製品別ヘッダ／APIサーバーヘッダの include path を渡さない → 機種依存の混入はビルドエラーで検出" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="802" width="980" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
