          </mxGeometry>
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-67" value="起動時の登録・指定" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1590" width="240" height="26" as="geometry" />
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#94A3B8;dashed=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2160" y="1643" as="sourcePoint" />
            <mxPoint x="2210" y="1643" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-69" value="将来" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1630" width="240" height="26" as="geometry" />
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-70" value="部品と関数の詳細は「2.詳細ブロック図」、&lt;br&gt;呼出しと戻りは「3〜5.関係図」" style="text;html=1;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="2160" y="1670" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-71" value="&lt;b&gt;呼出しの方向&lt;/b&gt;（外＝外部コンポーネント側、内＝PCL・REF側）&lt;br&gt;・&lt;b&gt;外 → 内&lt;/b&gt;：要求・取消・照会・情報取得・設定変更 … Connector が公開APIを呼び、EIF が PCL・REF を呼ぶ（黒の実線）&lt;br&gt;・&lt;b&gt;内 → 外&lt;/b&gt;：完了通知・イベント通知 … PCL・REF が EIF を呼び、EIF が Connector の callback を呼ぶ（青の破線）&lt;br&gt;・起動時：Connector が EIF に callback を登録し、機種セットアップが Frame に Accessor をつなぐ（紫の点線）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#FFFBEB;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="540" y="1590" width="980" height="140" as="geometry" />
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-72" value="&lt;b&gt;部品ごとの責務・依存してよいもの・持つデータ&lt;/b&gt;（データは、そのデータが依存するものを参照してよい部品に置く。仕様設計書 9.5、11.1）&lt;table style=&quot;border-collapse:collapse;width:100%;margin-top:8px;font-size:13px;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;background:#E2E8F0;&quot;&gt;部品&lt;/th&gt;&lt;th style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;background:#E2E8F0;&quot;&gt;受け取る形 → 渡す形&lt;/th&gt;&lt;th style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;background:#E2E8F0;&quot;&gt;責務（変換・処理）&lt;/th&gt;&lt;th style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;background:#E2E8F0;&quot;&gt;依存してよいもの&lt;/th&gt;&lt;th style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;background:#E2E8F0;&quot;&gt;持つデータ（置き場所）&lt;/th&gt;&lt;th style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;background:#E2E8F0;&quot;&gt;持たないもの&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;&lt;b&gt;Connector&lt;/b&gt;&lt;br&gt;connectors/&amp;lt;接続先&amp;gt;/&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;外部の形式 → 公開API（公開ID・公開モデル）&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;外部コンポーネントとの接続を持つ（例：APIサーバーへcallbackを登録）。外部要求→公開要求、要求粒度の吸収、同期応答の待ち・即時応答＋遅延応答。完了・イベント→外部の形式。&lt;br&gt;&lt;b&gt;外部が公開APIの形で要求できるなら変換表は不要（素通し）&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;公開ヘッダー、その外部コンポーネントのヘッダー&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;外部の形式 ⇔ 公開IDの変換表（例：ジョブ種別→公開要求ID）&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;PCL・REFのID・型、機種の知識&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;&lt;b&gt;Frame&lt;/b&gt;&lt;br&gt;frame/&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;公開API → 下位IF（どちらも公開ID・公開モデル）&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;機種・接続先によらない処理：公開範囲の確認（表はAccessor）、要求の受付と応答先の振り分け、設定のマージ、差分、配信&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;EIFの型だけ&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Connector登録表、要求台帳、設定定義表、通知定義表、前回値（StateCache）&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;外部の形式、PCL・REFの型、機種の知識&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;&lt;b&gt;Accessor&lt;/b&gt;&lt;br&gt;accessors/pcl|ref/&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;下位IF → PCL・REFの公開API（製品要求ID、REFのID・型）&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;PCL・REFのAPI呼出しと結果コードの変換（共通処理）。公開範囲の定義と、ID・型の変換（機種ごとの対応表）&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;公開ヘッダー、下位IF、PCL・REFの公開ヘッダー（REFの製品別ヘッダーは models/ だけ）&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;PCL要求の対応表、REF情報・設定の対応表と変換関数（models/&amp;lt;MODEL&amp;gt;/）&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;外部の形式、受付可否などの判断&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;&lt;b&gt;機種セットアップ&lt;/b&gt;&lt;br&gt;setup/&amp;lt;MODEL&amp;gt;/&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;－&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Frameの下位IFにどのAccessorをつなぐかを決める（設定の書込み先を含む）&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;上記の公開部分&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;つなぐAccessorの指定&lt;/td&gt;&lt;td style=&quot;border:1px solid #94A3B8;padding:6px;vertical-align:top;text-align:left;&quot;&gt;処理のロジック&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="250" y="1950" width="1830" height="520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
