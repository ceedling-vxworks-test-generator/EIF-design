Geometry></mxCell><mxCell id="h4-a42" value="同期呼出しの戻り" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="943" width="240" height="26" as="geometry"/></mxCell><mxCell id="h4-e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#2563EB;fontColor=#1D4ED8;dashed=1;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1535" y="993" as="sourcePoint"/><mxPoint x="1590" y="993" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h4-a44" value="非同期コールバック（別スレッド）" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="981" width="240" height="26" as="geometry"/></mxCell><mxCell id="h4-e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7C3AED;fontColor=#6D28D9;dashed=1;dashPattern=2 4;strokeWidth=2.5;endArrow=diamond;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1535" y="1031" as="sourcePoint"/><mxPoint x="1590" y="1031" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h4-a46" value="起動時の注入・登録" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="1019" width="240" height="26" as="geometry"/></mxCell><mxCell id="h4-e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#EA580C;fontColor=#C2410C;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1535" y="1069" as="sourcePoint"/><mxPoint x="1590" y="1069" as="targetPoint"/></mxGeometry></mxCell><mxCell id="h4-a48" value="対応表・定義表の参照" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="1057" width="240" height="26" as="geometry"/></mxCell><mxCell id="h4-a49" value="[C2] APIサーバーのblockingスレッド&lt;br&gt;[C3] PCLの要求処理context&lt;br&gt;[C4] REFの通知ワーカー&lt;br&gt;[C1] 起動処理" style="text;html=1;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1535" y="1100" width="300" height="90" as="geometry"/></mxCell><mxCell id="h4-a50" value="&lt;b&gt;読み方のポイント&lt;/b&gt;&lt;br&gt;&lt;br&gt;・コア（六角形）から外へ出る線は、必ず紫のポートを通る&lt;br&gt;・PCL・REFの型を知っているのはオレンジのアダプタだけ&lt;br&gt;・機種で変わるのは点線の「対応表」だけ&lt;br&gt;・青の非同期線は呼び出したスレッド（[C3]／[C4]）のまま進み、EIFはタスクやキューを挟まない&lt;br&gt;・PCLの完了は要求台帳で要求元を引き、そのアダプタにだけ返す" style="text;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#64748B;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="480" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5.要求と応答の流れ" id="h5"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h5-a1" value="&lt;b style='font-size:22px'&gt;要求と応答の流れ（ヘキサゴナル版）&lt;/b&gt;　　受付は同期・結果は非同期。チケットで要求元へ返す" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="1700" height="50" as="geometry"/></mxCell><mxCell id="h5-SV" value="&lt;b&gt;APIサーバー&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="70" width="195" height="56" as="geometry"/></mxCell><mxCell id="h5-a2" value="" style="rounded=0;fillColor=#CBD5E1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="326" y="126" width="3" height="934" as="geometry"/></mxCell><mxCell id="h5-DA" value="&lt;b&gt;使う側アダプタ&lt;br&gt;（api_server）&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=14;spacing=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" p