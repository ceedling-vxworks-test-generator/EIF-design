        <mxCell id="nizJxYM3RZs7sc-WjUhk-58" value="起動時：つなぐAccessorを指定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7C3AED;fontColor=#6D28D9;dashed=1;dashPattern=2 4;strokeWidth=2.5;endArrow=diamond;endFill=0;exitX=0.1373;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="nizJxYM3RZs7sc-WjUhk-31" target="nizJxYM3RZs7sc-WjUhk-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7C3AED;fontColor=#6D28D9;dashed=1;dashPattern=2 4;strokeWidth=2.5;endArrow=diamond;endFill=0;exitX=0.6667;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="nizJxYM3RZs7sc-WjUhk-31" target="nizJxYM3RZs7sc-WjUhk-25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-60" value="&lt;b&gt;何が変わったら、どこを変えるか&lt;/b&gt;（どの場合も Frame は変えない）&lt;br&gt;・接続相手が増える・変わる → &lt;b&gt;connectors/&lt;/b&gt; に Connector を足す・直す&lt;br&gt;・機種が変わる → &lt;b&gt;accessors/pcl|ref/models/&amp;lt;MODEL&amp;gt;/&lt;/b&gt; の対応表と &lt;b&gt;setup/&amp;lt;MODEL&amp;gt;/&lt;/b&gt; を書く&lt;br&gt;・PCL・REFのAPIが変わる → &lt;b&gt;accessors/pcl/&lt;/b&gt;、&lt;b&gt;accessors/ref/&lt;/b&gt; の共通処理を直す&lt;br&gt;・設定の書込み先をPCL経由にする → &lt;b&gt;setup/&amp;lt;MODEL&amp;gt;/&lt;/b&gt; で設定保存IFにつなぐAccessorを替える" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="250" y="1770" width="1830" height="150" as="geometry" />
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-61" value="凡例" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;strokeWidth=2;dashed=1;fillColor=#FFFFFF;strokeColor=#64748B;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2140" y="1470" width="330" height="260" as="geometry" />
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#1F2937;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2160" y="1523" as="sourcePoint" />
            <mxPoint x="2210" y="1523" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-63" value="同期呼出し" style="text;html=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
