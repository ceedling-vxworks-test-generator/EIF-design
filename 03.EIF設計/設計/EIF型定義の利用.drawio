"568" width="228" height="116" as="geometry"/></mxCell><mxCell id="t3-28" value="&lt;b&gt;⑦ 設定変更&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;EIF_PatchSetting&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#CBD5E1&#x27;&gt;－&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1458" y="568" width="228" height="116" as="geometry"/></mxCell><mxCell id="t3-29" value="&lt;b&gt;⑧ イベント通知&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;REFの通知 → on_event&lt;/span&gt;&lt;br&gt;&lt;b style=&#x27;color:#1D4ED8&#x27;&gt;読む&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px&#x27;&gt;on_event()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=12;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1694" y="568" width="228" height="116" as="geometry"/></mxCell><mxCell id="t3-30" value="メンバーの行：白＝どこかの機能が使う、灰色＝今の実装では読み書きする機能が無い。線の色は機能ごと。タイミングの番号は ① 起動 ② Connector登録 ③ 開始 ④ 要求受付 ⑤ 完了通知 ⑥ 情報取得 ⑦ 設定変更 ⑧ イベント通知" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="694" width="1890" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3.1.4 SubscriptionMapping" id="t4"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t4-1" value="&lt;font style=&#x27;font-size:22px&#x27;&gt;&lt;b&gt;3.1.4 SubscriptionMapping（EIF_SubscriptionRequest[]）（購読要求定義）&lt;/b&gt;&lt;/font&gt;　　" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1900" height="50" as="geometry"/></mxCell><mxCell id="t4-2" value="