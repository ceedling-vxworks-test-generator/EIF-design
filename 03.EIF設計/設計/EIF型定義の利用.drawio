="1" source="t6-6" target="t6-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t6-30" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.750;" edge="1" parent="1" source="t6-8" target="t6-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t6-31" value="&lt;span style=&#x27;background:#334155;color:#FFFFFF;padding:0 4px&#x27;&gt;⑧ イベント通知&lt;/span&gt;　&lt;span style=&#x27;font-size:10px;color:#475569&#x27;&gt;4.2.5&lt;/span&gt;&lt;br&gt;&lt;b&gt;eif_dispatch_event()&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#FFFFFF;background:#1D4ED8;padding:0 3px;font-weight:bold&#x27;&gt;読&lt;/span&gt; &lt;span style=&#x27;font-size:11px&#x27;&gt;id, on_event, user_context&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#334155&#x27;&gt;購読表の connector_mask に id のビットが立つ Connector の on_event を、登録順に呼ぶ&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1490" y="529" width="440" height="91" as="geometry"/></mxCell><mxCell id="t6-32" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#DB2777;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.250;" edge="1" parent="1" source="t6-4" target="t6-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t6-33" value="" style="html=1;edgeStyle=none;labelBackgroundColor=#FFFFFF;fontSize=11;endArrow=block;endFill=1;strokeColor=#DB2777;strokeWidth=1.6;opacity=85;exitX=1;exitY=0.5;entryX=0;entryY=0.500;" edge="1" parent="1" source="t6-7" target="t6-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t6-34" value="" style="html=1;edgeStyle=none;labelBack