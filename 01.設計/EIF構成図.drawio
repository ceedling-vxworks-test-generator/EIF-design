"points"><mxPoint x="712" y="622"/><mxPoint x="712" y="225"/><mxPoint x="945" y="225"/></Array></mxGeometry></mxCell><mxCell id="p3-a12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-AS_INT" target="p3-ING_PD"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="676" y="220"/><mxPoint x="812" y="220"/></Array></mxGeometry></mxCell><mxCell id="p3-a13" value="DEVを直接参照（レイヤスキップ）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#cc0000;fontColor=#cc0000;strokeWidth=2;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-ING_PD" target="p3-PDS"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1064" y="760"/><mxPoint x="1050" y="760"/></Array></mxGeometry></mxCell><mxCell id="p3-a14" value="下位(PCL)→上位(EIF)&lt;br&gt;依存" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#cc0000;fontColor=#cc0000;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-SU" target="p3-ADP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="760"/><mxPoint x="124" y="760"/></Array></mxGeometry></mxCell><mxCell id="p3-a15" value="未接続（旧API）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#999999;fontColor=#666666;dashed=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-ING_JOB" target="p3-RI"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="812" y="715"/><mxPoint x="532" y="715"/></Array></mxGeometry></mxCell><mxCell id="p3-a16" value="APIサーバーのヘッダへ依存&lt;br&gt;（server_api.h 等）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#cc0000;fontColor=#cc0000;strokeWidth=2;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-ADP_INC" target="p3-AS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-a17" value="&lt;b&gt;A-1&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffcc99;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="278" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a18" value="&lt;b&gt;A-2&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffcc99;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="446" y="278" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a19" value="&lt;b&gt;A-7&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffcc99;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="492" y="278" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a20" value="&lt;b&gt;D-1&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="538" y="278" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a21" value="&lt;b&gt;A-1&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffcc99;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="278" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a22" value="&lt;b&gt;A-5&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffcc99;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="352" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a23" value="&lt;b&gt;B-1&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="126" y="352" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a24" value="&lt;b&gt;B-4&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="172" y="352" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a25" value="&lt;b&gt;B-5&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="218" y="352" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a26" value="&lt;b&gt;C-5&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="264" y="352" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a27" value="&lt;b&gt;B-2&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="352" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a28" value="&lt;b&gt;C-3&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="546" y="352" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a29" value="&lt;b&gt;B-3&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="462" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a30" value="&lt;b&gt;C-2&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="546" y="462" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a31" value="&lt;b&gt;A-3&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffcc99;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="600" y="676" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a32" value="&lt;b&gt;B-6&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="503" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a33" value="&lt;b&gt;C-6&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="966" y="503" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a34" value="&lt;b&gt;A-4&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffcc99;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="652" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a35" value="&lt;b&gt;B-4&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="966" y="652" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a36" value="&lt;b&gt;A-6&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffcc99;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="982" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a37" value="&lt;b&gt;C-1&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="982" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a38" value="&lt;b&gt;D-2&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="446" y="982" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a39" value="&lt;b&gt;D-3&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="492" y="982" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a40" value="&lt;b&gt;C-4&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="92" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a41" value="&lt;b&gt;D-1&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="426" y="92" width="42" height="22" as="geometry"/></mxCell><mxCell id="p3-a42" value="&lt;b style='font-size:13px'&gt;課題一覧（重大度：高＝次機種でEIF作り直しの直接原因 または 機能が成立しない）&lt;/b&gt;&lt;br&gt;&lt;table border='1' cellpadding='3' style='border-collapse:collapse;font-size:10px;width:100%'&gt;&lt;tr style='background:#eeeeee'&gt;&lt;th&gt;ID&lt;/th&gt;&lt;th&gt;区間&lt;/th&gt;&lt;th&gt;重大度&lt;/th&gt;&lt;th&gt;課題&lt;/th&gt;&lt;th&gt;影響&lt;/th&gt;&lt;th&gt;対策（設計書18章）&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#f8cecc'&gt;&lt;b&gt;B-1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF→REF&lt;/td&gt;&lt;td align='center'&gt;高&lt;/td&gt;&lt;td&gt;Adapter共通部がRIMの&lt;b&gt;製品別ヘッダ&lt;/b&gt;（rim/include/MiniPrinter）と製品別API（RIM_GetNetworkInfo / RIM_GetHostname / RIM_GetMacAddress）を直接呼ぶ&lt;/td&gt;&lt;td&gt;次機種でrest/*.cを書き直し&lt;/td&gt;&lt;td&gt;Step4：InfoMap＋変換関数へ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#f8cecc'&gt;&lt;b&gt;B-2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF→REF&lt;/td&gt;&lt;td align='center'&gt;高&lt;/td&gt;&lt;td&gt;購読表 k_subscriptions に REFのID（RI_DATA_FAULT_INFO_LIST）とコールバックが共通コードとして直書き&lt;/td&gt;&lt;td&gt;次機種でws/*.cを書き直し&lt;/td&gt;&lt;td&gt;Step3：SubscriptionTable（製品CFG）＋SubscriptionManager（Frame）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#f8cecc'&gt;&lt;b&gt;B-3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;REF→EIF→API&lt;/td&gt;&lt;td align='center'&gt;高&lt;/td&gt;&lt;td&gt;通知コールバックが製品型（RIM_FaultInfoList）を直接解釈し、仮値（NET0001 / E10001）で公開形式を作る。取得・変換・送信が1関数に混在&lt;/td&gt;&lt;td&gt;同上・公開値が不正&lt;/td&gt;&lt;td&gt;Step3：build_events＋コード対応表&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#f8cecc'&gt;&lt;b&gt;B-4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;API→EIF→PCL&lt;/td&gt;&lt;td align='center'&gt;高&lt;/td&gt;&lt;td&gt;公開範囲がコードで表現（UC_ERR_NOT_IMPLEMENTEDのスタブ関数群）。job_type→製品要求の対応がswitch直書き&lt;/td&gt;&lt;td&gt;機種ごとに公開範囲を変えるたびにコード修正&lt;/td&gt;&lt;td&gt;Step6：RequestMap&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#f8cecc'&gt;&lt;b&gt;B-5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF→REF&lt;/td&gt;&lt;td align='center'&gt;高&lt;/td&gt;&lt;td&gt;設定書込みで製品別API（RIM_SetNetworkInfo）と製品別型を共通部が直接呼ぶ。※REFへの直接書込み自体はQA-01で許容（全体構成設計 S3 の例外として追記依頼）&lt;/td&gt;&lt;td&gt;次機種でsettings.cを書き直し&lt;/td&gt;&lt;td&gt;Step5：SettingMap＋RefPort.set_binary&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#f8cecc'&gt;&lt;b&gt;B-6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;API→EIF→DEV&lt;/td&gt;&lt;td align='center'&gt;高&lt;/td&gt;&lt;td&gt;印字データがDEV（PrintDataStorage / PrintStorage）を直接参照（R2 レイヤスキップ）。arena 1GiB等の製品依存値がコード定数&lt;/td&gt;&lt;td&gt;DataPlane・メモリ構成の変更がEIFへ波及&lt;/td&gt;&lt;td&gt;Step8：貯蔵チャネル（PCL経由）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#ffcc99'&gt;&lt;b&gt;A-1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF内部&lt;/td&gt;&lt;td align='center'&gt;中&lt;/td&gt;&lt;td&gt;フォルダ名が責務を表さない：ApiServerAdapter＝プロトコル名、ExternalRequestIngress＝PCLの同名コンポーネント（ExternalRequestIngressSubmit）と衝突&lt;/td&gt;&lt;td&gt;どこに何を書くか分からない&lt;/td&gt;&lt;td&gt;Step1：Binding/Boundary/Frame/product の4区分&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#ffcc99'&gt;&lt;b&gt;A-2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF内部&lt;/td&gt;&lt;td align='center'&gt;中&lt;/td&gt;&lt;td&gt;公開ヘッダが3か所（ApiServerAdapter/include、include/ws、ExternalRequestIngress/include）に分散。「唯一の公開ヘッダ」が無い（NFR-01）&lt;/td&gt;&lt;td&gt;境界が曖昧&lt;/td&gt;&lt;td&gt;Step1：include/ へ集約&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#ffcc99'&gt;&lt;b&gt;A-3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF内部&lt;/td&gt;&lt;td align='center'&gt;低&lt;/td&gt;&lt;td&gt;WS Publisherの配置不整合（api_server_ws_publisher.c は src直下、ヘッダは src/ws）。job/consumable Publisher は未使用のまま公開&lt;/td&gt;&lt;td&gt;保守性低下&lt;/td&gt;&lt;td&gt;Step1／Step6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#ffcc99'&gt;&lt;b&gt;A-4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF内部&lt;/td&gt;&lt;td align='center'&gt;中&lt;/td&gt;&lt;td&gt;ビルド対象外の external_request_ingress.c（旧API control_runtime_post_event 依存）とREADMEの古い接合メモが残存&lt;/td&gt;&lt;td&gt;誤用・混乱&lt;/td&gt;&lt;td&gt;Step1：削除&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#ffcc99'&gt;&lt;b&gt;A-5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF内部&lt;/td&gt;&lt;td align='center'&gt;中&lt;/td&gt;&lt;td&gt;REST 1関数に「APIサーバー型変換＋REFアクセス＋製品型変換＋エラー変換」が混在（settings.c）&lt;/td&gt;&lt;td&gt;差分の局所化ができない&lt;/td&gt;&lt;td&gt;Step4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#ffcc99'&gt;&lt;b&gt;A-6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PCL→EIF&lt;/td&gt;&lt;td align='center'&gt;中&lt;/td&gt;&lt;td&gt;EIFの登録・起動・印字ingress初期化をPCLのStartUp（StartUpApiServer.c / StartUpTask.c）で実施。下位(PCL)が上位(EIF)とAPIサーバーへ依存&lt;/td&gt;&lt;td&gt;依存規則違反・初期化順が不明確&lt;/td&gt;&lt;td&gt;Step7：起動処理（Main）へ移動（QA-04）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#ffcc99'&gt;&lt;b&gt;A-7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF内部&lt;/td&gt;&lt;td align='center'&gt;低&lt;/td&gt;&lt;td&gt;命名規則の混在（ApiServerRestSettings_Configure / external_request_printdata_initialize）&lt;/td&gt;&lt;td&gt;可読性低下&lt;/td&gt;&lt;td&gt;Step1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#e1d5e7'&gt;&lt;b&gt;C-1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF→PCL&lt;/td&gt;&lt;td align='center'&gt;高&lt;/td&gt;&lt;td&gt;PCL未接続（jobs系すべてNOT_IMPLEMENTED）。要求ハンドル⇔generation IDの相関、完了callbackの受け口が無い&lt;/td&gt;&lt;td&gt;製品要求が外部から使えない&lt;/td&gt;&lt;td&gt;Step6：RequestGateway／RequestTracker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#e1d5e7'&gt;&lt;b&gt;C-2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;REF→EIF&lt;/td&gt;&lt;td align='center'&gt;中&lt;/td&gt;&lt;td&gt;異常通知に差分検知が無い（count&gt;0でRAISED固定、前回値なし）&lt;/td&gt;&lt;td&gt;発生/解消が正しく通知されない&lt;/td&gt;&lt;td&gt;Step3：EIFが前回値を保持して差分導出（QA-03）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#e1d5e7'&gt;&lt;b&gt;C-3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF→REF&lt;/td&gt;&lt;td align='center'&gt;中&lt;/td&gt;&lt;td&gt;RIMに購読解除APIが無く、登録失敗時に部分登録が残る&lt;/td&gt;&lt;td&gt;再初期化不可&lt;/td&gt;&lt;td&gt;REFへ依頼（QA-07）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#e1d5e7'&gt;&lt;b&gt;C-4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;全区間&lt;/td&gt;&lt;td align='center'&gt;中&lt;/td&gt;&lt;td&gt;各コールバックの実行スレッド・再入制約が未定義（APIサーバー複数スレッド／RIMワーカー／PCL context）&lt;/td&gt;&lt;td&gt;競合・デッドロックの潜在&lt;/td&gt;&lt;td&gt;設計書15章で定義&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#e1d5e7'&gt;&lt;b&gt;C-5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;REF→EIF→API&lt;/td&gt;&lt;td align='center'&gt;低&lt;/td&gt;&lt;td&gt;結果コード変換が暫定（settings_map_rim_status にTODO。RI_INVALID_PARAMETER を外部入力不正へ誤変換）&lt;/td&gt;&lt;td&gt;誤ったHTTPステータス&lt;/td&gt;&lt;td&gt;設計書16章&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#e1d5e7'&gt;&lt;b&gt;C-6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;API→EIF&lt;/td&gt;&lt;td align='center'&gt;中&lt;/td&gt;&lt;td&gt;memory buffer に同期が無いため全量受信を待ってからコピー（TODO(mb-sync)）&lt;/td&gt;&lt;td&gt;印字性能（80MB/s）を阻害&lt;/td&gt;&lt;td&gt;APIサーバーへ同期追加を依頼（QA-06）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#dae8fc'&gt;&lt;b&gt;D-1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;API⇔EIF&lt;/td&gt;&lt;td align='center'&gt;高&lt;/td&gt;&lt;td&gt;EIF全体がAPIサーバーのヘッダ（server_api.h / rest_callbacks.h / ws_events.h / memory_buffer.h）へ依存（全体構成設計 2.3、NFR-07違反）&lt;/td&gt;&lt;td&gt;外部通信ライブラリの変更がEIF全体へ波及&lt;/td&gt;&lt;td&gt;Step1〜：Binding分離&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#dae8fc'&gt;&lt;b&gt;D-2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;PCL⇔API&lt;/td&gt;&lt;td align='center'&gt;低&lt;/td&gt;&lt;td&gt;uc_result_t がAPIサーバー uc_types.h と PCL product_control_result.h で二重定義（include guard共有）&lt;/td&gt;&lt;td&gt;片方の変更で不整合&lt;/td&gt;&lt;td&gt;型の所有者を決定（QA-12）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='background:#dae8fc'&gt;&lt;b&gt;D-3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;EIF→PCL&lt;/td&gt;&lt;td align='center'&gt;低&lt;/td&gt;&lt;td&gt;PCLの Submit に要求パラメータを渡す口が無い（ジョブpayloadを渡せない）&lt;/td&gt;&lt;td&gt;パラメータ付き要求が実現不可&lt;/td&gt;&lt;td&gt;現時点では不要（QA-02 保留）&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#333333;spacing=6;" vertex="1" parent="1"><mxGeometry x="1170" y="85" width="900" height="1150" as="geometry"/></mxCell><mxCell id="p3-a43" value="&lt;b&gt;機種依存（B群）が作り直しにつながる理由&lt;/b&gt;&lt;br&gt;現行は「どのREF項目を購読するか／どのREF APIで取るか／どの製品要求へ変換するか」（＝機種で変わる情報）と、「登録ループ・振り分け・エラー変換・送信」（＝機種で変わらない処理）が同じ関数・同じファイルに書かれている。さらにREFの製品別ヘッダ（include/MiniPrinter）をCMakeで直接参照しているため、次機種ではREF IDと型がすべて変わり、rest/*.c・ws/*.c をほぼ全面的に書き直すことになる。&lt;br&gt;&lt;br&gt;&lt;b&gt;対策の骨子（設計書11章・17章）&lt;/b&gt;：機種で変わる情報を製品CFG（表1行＋純粋な変換関数）へ追い出し、Frameは表を引いて共通処理を回すだけにする。FrameのCMakeには REF製品別ヘッダとAPIサーバーヘッダのinclude pathを&lt;u&gt;渡さない&lt;/u&gt;ことで、機種依存の混入をビルドエラーにする。→「4.機種依存の分離（現行→改善）」シート" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#fff8f8;strokeColor=#b85450;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1100" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4.機種依存の分離（現行→改善）" id="p4"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4-a1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;機種依存の分離方式：現行 → 改善後（Frame＋製品CFG）&lt;/b&gt;&lt;/font&gt;　赤＝機種依存、緑＝共通処理、青＝APIサーバー依存" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="40" as="geometry"/></mxCell><mxCell id="p4-a2" value="&lt;b&gt;現行：1ファイル／1関数に混在&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="640" height="30" as="geometry"/></mxCell><mxCell id="p4-a3" value="&lt;b&gt;改善後：処理（Frame）と定義（製品CFG）を分割&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="50" width="980" height="30" as="geometry"/></mxCell><mxCell id="p4-a4" value="&lt;b&gt;例1：情報変化の通知（WebSocket）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=12;fillColor=#eeeeee;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1700" height="24" as="geometry"/></mxCell><mxCell id="p4-a5" value="api_server_ws_subscribe.c ＋ api_server_ws_callbacks.c" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="640" height="224" as="geometry"/></mxCell><mxCell id="p4-a6" value="k_subscriptions = { RI_TARGET_DATA, &lt;b&gt;RI_DATA_FAULT_INFO_LIST&lt;/b&gt;, ON_CHANGE, 0, ApiServerWsCallback_FaultInfoList }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="620" height="34" as="geometry"/></mxCell><mxCell id="p4-a7" value="for (各行) RIM_Subscribe(...)、失敗で中断" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a8" value="callback：&lt;b&gt;GetRIMFaultInfoList&lt;/b&gt;(&amp;amp;RIM_FaultInfoList)（製品別API・製品別型）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a9" value="RIM_FaultInfoList → alarm_id / alarm_code（仮値 NET0001 / E10001）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a10" value="count&amp;gt;0 なら RAISED、0 なら RESOLVED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="280" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a11" value="ws_error_raised_payload_t を組み立て → server_ws_emit_event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="310" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a12" value="Frame：SubscriptionManager（全機種共通）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#eef7e8;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="470" height="194" as="geometry"/></mxCell><mxCell id="p4-a13" value="EIF_Start：Profileの購読表を順に RefPort.subscribe（トランポリン1つを登録）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="150" width="450" height="34" as="geometry"/></mxCell><mxCell id="p4-a14" value="トランポリン：subscriptionId → 表の行を検索" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="190" width="450" height="24" as="geometry"/></mxCell><mxCell id="p4-a15" value="RefPort.get_binary(行のsource)＋サイズ検証" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="220" width="450" height="24" as="geometry"/></mxCell><mxCell id="p4-a16" value="作業領域（前回値）を行ごとに確保・排他" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="250" width="450" height="24" as="geometry"/></mxCell><mxCell id="p4-a17" value="行の build_events を呼ぶ → EventDispatcher で配信" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="280" width="450" height="24" as="geometry"/></mxCell><mxCell id="p4-a18" value="製品CFG：MiniPrinter（機種ごと）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="120" width="490" height="156" as="geometry"/></mxCell><mxCell id="p4-a19" value="購読表1行：{ RI_TARGET_DATA, RI_DATA_FAULT_INFO_LIST, ON_CHANGE, source, work=sizeof(RIM_FaultInfoList), mp_build_fault_events }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="150" width="470" height="46" as="geometry"/></mxCell><mxCell id="p4-a20" value="mp_build_fault_events(今回, 前回)：差分 → ERROR_RAISED / RESOLVED（純粋関数）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="202" width="470" height="34" as="geometry"/></mxCell><mxCell id="p4-a21" value="コード対応表：Faultコード → 公開アラームID/コード" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="242" width="470" height="24" as="geometry"/></mxCell><mxCell id="p4-a22" value="Binding（EventBinding）：EIF_Event → ws_event_t → server_ws_emit_event（全機種共通・APIサーバー依存はここだけ）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="314" width="980" height="26" as="geometry"/></mxCell><mxCell id="p4-a23" value="分割" style="shape=flexArrow;endArrow=classic;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="688" y="210" as="sourcePoint"/><mxPoint x="752" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-a24" value="&lt;b&gt;例2：システム情報の取得（REST GET /settings/network）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=12;fillColor=#eeeeee;" vertex="1" parent="1"><mxGeometry x="40" y="374" width="1700" height="24" as="geometry"/></mxCell><mxCell id="p4-a25" value="rest/settings.c：settings_get_network()" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="640" height="154" as="geometry"/></mxCell><mxCell id="p4-a26" value="&lt;b&gt;RIM_GetNetworkInfo / RIM_GetHostname / RIM_GetMacAddress&lt;/b&gt;（製品別API）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="434" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a27" value="失敗時 settings_map_rim_status() でエラー変換、ログ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="464" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a28" value="RIM_network_info_t（製品別型）→ IPv4/MAC/ホスト名を文字列化" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="494" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a29" value="network_settings_t（APIサーバー型）へ格納して返す" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="524" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a30" value="Frame：InfoReader（全機種共通）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#eef7e8;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="404" width="470" height="124" as="geometry"/></mxCell><mxCell id="p4-a31" value="公開情報IDで InfoMap を検索（無ければ NOT_EXPOSED）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="434" width="450" height="24" as="geometry"/></mxCell><mxCell id="p4-a32" value="行の source を RefPort.get_binary で取得＋サイズ検証" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="464" width="450" height="24" as="geometry"/></mxCell><mxCell id="p4-a33" value="行の convert を呼ぶ／結果コード変換（16章）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="494" width="450" height="24" as="geometry"/></mxCell><mxCell id="p4-a34" value="製品CFG：MiniPrinter（機種ごと）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="404" width="490" height="126" as="geometry"/></mxCell><mxCell id="p4-a35" value="InfoMap1行：{ EIF_INFO_NETWORK_SETTINGS, {NETWORK_INFO, HOSTNAME, MACADDRESS}, mp_convert_network_settings }" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="434" width="470" height="46" as="geometry"/></mxCell><mxCell id="p4-a36" value="mp_convert_network_settings：RIM_network_info_t → 公開モデル（現行の変換関数を移設）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="486" width="470" height="34" as="geometry"/></mxCell><mxCell id="p4-a37" value="Binding（RestBinding）：公開モデル → network_settings_t の詰め替えのみ（全機種共通）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="528" width="980" height="26" as="geometry"/></mxCell><mxCell id="p4-a38" value="分割" style="shape=flexArrow;endArrow=classic;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="688" y="474" as="sourcePoint"/><mxPoint x="752" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-a39" value="&lt;b&gt;例3：製品要求（REST POST /jobs）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontSize=12;fillColor=#eeeeee;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="1700" height="24" as="geometry"/></mxCell><mxCell id="p4-a40" value="rest/jobs.c ＋ external_request_ingress.c（未接続）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="618" width="640" height="154" as="geometry"/></mxCell><mxCell id="p4-a41" value="switch(job_type) { JOB_TYPE_PRINT → PCL_JOB_TYPE_PRINT … }（公開範囲と対応がコード）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="648" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a42" value="未公開の要求は UC_ERR_NOT_IMPLEMENTED を返すスタブ関数で表現" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="678" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a43" value="（未実装）PCL Submit・完了callback・相関" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="708" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a44" value="job_create_request_t / accepted_job_t を直接扱う" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="738" width="620" height="24" as="geometry"/></mxCell><mxCell id="p4-a45" value="Frame：RequestGateway / RequestTracker（全機種共通）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#eef7e8;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="618" width="470" height="124" as="geometry"/></mxCell><mxCell id="p4-a46" value="公開要求IDで RequestMap を検索（無ければ NOT_EXPOSED）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="648" width="450" height="24" as="geometry"/></mxCell><mxCell id="p4-a47" value="build_params → PclPort.submit(…, 完了トランポリン)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="678" width="450" height="24" as="geometry"/></mxCell><mxCell id="p4-a48" value="要求ハンドル払い出し・相関・先着完了・完了イベント配信" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="708" width="450" height="24" as="geometry"/></mxCell><mxCell id="p4-a49" value="製品CFG：MiniPrinter（機種ごと）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="618" width="490" height="116" as="geometry"/></mxCell><mxCell id="p4-a50" value="RequestMap：{ EIF_REQ_HEAD_CLEANING, PRODUCT_REQUEST_ID_NORMAL_PURGE_ALL, sizeof(param), mp_build_head_cleaning } …" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="648" width="470" height="46" as="geometry"/></mxCell><mxCell id="p4-a51" value="mp_build_head_cleaning：公開パラメータ → 製品要求パラメータ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1260" y="700" width="470" height="24" as="geometry"/></mxCell><mxCell id="p4-a52" value="Binding（RestBinding）：job_type → 公開要求ID、要求ハンドル → job_id 文字列（全機種共通）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="742" width="980" height="26" as="geometry"/></mxCell><mxCell id="p4-a53" value="分割" style="shape=flexArrow;endArrow=classic;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="688" y="688" as="sourcePoint"/><mxPoint x="752" y="688" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-a54" value="&lt;b&gt;現行：次機種で変更が必要な範囲&lt;/b&gt;&lt;br&gt;・rest/*.c、ws/*.c、ExternalRequestIngress/*.c のほぼ全体（赤の行が全ファイルに散在）&lt;br&gt;・CMakeLists.txt（include/MiniPrinter の参照）&lt;br&gt;・PCL の StartUp（EIFの初期化を持っているため）&lt;br&gt;→ &lt;b&gt;実質的にEIFの作り直し&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="802" width="640" height="150" as="geometry"/></mxCell><mxCell id="p4-a55" value="&lt;b&gt;改善後：次機種で変更が必要な範囲&lt;/b&gt;&lt;br&gt;・product/&amp;lt;MODEL&amp;gt;/ の表と変換関数&lt;b&gt;だけ&lt;/b&gt;（Skeletonをコピーして作成）&lt;br&gt;・Frame・Binding・公開APIは変更しない（公開ID・公開モデル自体が増える場合のみ Boundary と Binding に追記）&lt;br&gt;・変換関数は純粋関数なので、REF・PCL・APIサーバー無しで単体試験できる&lt;br&gt;・Frame の CMake に REF製品別ヘッダ／APIサーバーヘッダの include path を渡さない → 機種依存の混入はビルドエラーで検出" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="802" width="980" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5.Frame／機種依存 分離構成" id="p5"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5-a1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;Frame／機種依存 分離構成図&lt;/b&gt;&lt;/font&gt;　緑・青＝全機種で同じソース　オレンジ＝機種ごとに作る部分（ここだけ）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1450" height="40" as="geometry"/></mxCell><mxCell id="p5-AS" value="&lt;b&gt;外部アプリケーション：APIサーバー&lt;/b&gt;（REST / WebSocket）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1000" height="55" as="geometry"/></mxCell><mxCell id="p5-BIND" value="Binding（binding/api_server/）… 全機種共通。APIサーバーのヘッダを参照するのはここだけ" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1000" height="75" as="geometry"/></mxCell><mxCell id="p5-a2" value="RestBinding&lt;br&gt;REST⇔EIF公開API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="168" width="290" height="40" as="geometry"/></mxCell><mxCell id="p5-a3" value="EventBinding&lt;br&gt;EIF_Event→WebSocket" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="168" width="290" height="40" as="geometry"/></mxCell><mxCell id="p5-a4" value="PrintDataSource（T.B.D）&lt;br&gt;印字データの読出し口" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="710" y="168" width="290" height="40" as="geometry"/></mxCell><mxCell id="p5-CMN" value="EIF 共通部（全機種で同じソース）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fcfcfc;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1000" height="330" as="geometry"/></mxCell><mxCell id="p5-BOUND" value="&lt;b&gt;Boundary（include/）&lt;/b&gt;公開API・公開ID・公開モデル … 外部アプリが参照する唯一のヘッダ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#b9e0a5;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="272" width="960" height="50" as="geometry"/></mxCell><mxCell id="p5-FRAME" value="Frame（frame/）… 処理だけを持つ。機種固有のID・型は一切書かない" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#eef7e8;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="335" width="960" height="220" as="geometry"/></mxCell><mxCell id="p5-a5" value="&lt;b&gt;RequestGateway&lt;/b&gt;&lt;br&gt;要求の受付&lt;br&gt;公開範囲判定" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="75" y="368" width="125" height="70" as="geometry"/></mxCell><mxCell id="p5-a6" value="&lt;b&gt;RequestTracker&lt;/b&gt;&lt;br&gt;要求と結果の&lt;br&gt;対応付け" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="368" width="125" height="70" as="geometry"/></mxCell><mxCell id="p5-a7" value="&lt;b&gt;InfoReader&lt;/b&gt;&lt;br&gt;情報の取得&lt;br&gt;＋変換呼出し" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="345" y="368" width="125" height="70" as="geometry"/></mxCell><mxCell id="p5-a8" value="&lt;b&gt;SettingMerger&lt;/b&gt;&lt;br&gt;設定の&lt;br&gt;マージ・書込み" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="368" width="125" height="70" as="geometry"/></mxCell><mxCell id="p5-a9" value="&lt;b&gt;SubscriptionManager&lt;/b&gt;&lt;br&gt;購読登録&lt;br&gt;通知の振り分け" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="615" y="368" width="125" height="70" as="geometry"/></mxCell><mxCell id="p5-a10" value="&lt;b&gt;EventDispatcher&lt;/b&gt;&lt;br&gt;通知先へ&lt;br&gt;配信" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="368" width="125" height="70" as="geometry"/></mxCell><mxCell id="p5-a11" value="&lt;b&gt;PrintDataIngress&lt;/b&gt;&lt;br&gt;印字データ&lt;br&gt;（T.B.D）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="885" y="368" width="125" height="70" as="geometry"/></mxCell><mxCell id="p5-F_INIT" value="&lt;b&gt;EIF_Initialize()&lt;/b&gt;&lt;br&gt;製品CFGの表を受け取り、検証して保持&lt;br&gt;（Frame側の受け口）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="75" y="460" width="330" height="75" as="geometry"/></mxCell><mxCell id="p5-F_PP" value="&lt;b&gt;PclPort&lt;/b&gt;&lt;br&gt;PCL公開APIの呼出し口" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="460" width="170" height="75" as="geometry"/></mxCell><mxCell id="p5-F_RP" value="&lt;b&gt;RefPort&lt;/b&gt;&lt;br&gt;REFの製品非依存API&lt;br&gt;の呼出し口" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="830" y="460" width="170" height="75" as="geometry"/></mxCell><mxCell id="p5-IFB" value="&lt;b&gt;Frame ⇔ 製品CFG の境界：ProductProfile&lt;/b&gt;（RequestMap / InfoMap / SettingMap / SubscriptionTable の4つの表＋変換関数）&lt;br&gt;製品CFGの &lt;b&gt;EIF_Setup()&lt;/b&gt; が表を組み立てて &lt;b&gt;EIF_Initialize()&lt;/b&gt; へ渡す（注入）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#f3e6ff;strokeColor=#9933ff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="1000" height="55" as="geometry"/></mxCell><mxCell id="p5-PROD" value="製品CFG（product/&amp;lt;MODEL&amp;gt;/）… 機種依存。ビルド時に MODEL で1つだけ選択" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="1000" height="245" as="geometry"/></mxCell><mxCell id="p5-P_MP" value="&lt;b&gt;MiniPrinter/&lt;/b&gt;（現行機種）&lt;br&gt;・RequestMap：公開要求→製品要求ID&lt;br&gt;・InfoMap：公開情報→REF ID＋変換&lt;br&gt;・SettingMap：公開設定→REF書込み先＋マージ&lt;br&gt;・SubscriptionTable：購読対象＋イベント生成&lt;br&gt;・コード対応表&lt;br&gt;・EIF_Setup()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="300" height="190" as="geometry"/></mxCell><mxCell id="p5-P_NX" value="&lt;b&gt;&amp;lt;次機種&amp;gt;/&lt;/b&gt;&lt;br&gt;&lt;br&gt;Skeleton をコピーして&lt;br&gt;表と変換関数を書く&lt;br&gt;&lt;br&gt;&lt;b&gt;次機種で新しく作るのはここだけ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="380" y="710" width="300" height="190" as="geometry"/></mxCell><mxCell id="p5-P_SK" value="&lt;b&gt;Skeleton/&lt;/b&gt;（雛形）&lt;br&gt;&lt;br&gt;全ての表が空＝何も公開しない&lt;br&gt;MODEL未指定時はこれが選ばれ、&lt;br&gt;誤って別機種のCFGでビルドされない" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="700" y="710" width="320" height="190" as="geometry"/></mxCell><mxCell id="p5-PCL" value="&lt;b&gt;製品制御層（PCL）&lt;/b&gt;&lt;br&gt;ExternalRequestIngressSubmit / Cancel / GetResult&lt;br&gt;完了callback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1080" y="335" width="400" height="100" as="geometry"/></mxCell><mxCell id="p5-REF" value="&lt;b&gt;参照サービス（REF／RIM）&lt;/b&gt;&lt;br&gt;製品非依存API：RIM_Subscribe / RIM_GetBinary / RIM_SetBinary&lt;br&gt;（製品別のID・型は製品CFGだけが参照）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1080" y="455" width="400" height="115" as="geometry"/></mxCell><mxCell id="p5-a12" value="コールバック（同期）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-AS" target="p5-BIND"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-a13" value="WebSocket送信" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-BIND" target="p5-AS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-a14" value="EIF公開API（同期）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-BIND" target="p5-BOUND"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-a15" value="要求（同期・受付のみ）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-F_PP" target="p5-PCL"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="552"/><mxPoint x="1060" y="552"/><mxPoint x="1060" y="405"/></Array></mxGeometry></mxCell><mxCell id="p5-a16" value="完了callback（非同期）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#0050ef;fontColor=#0050ef;dashed=1;strokeWidth=2;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.11;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-PCL" target="p5-FRAME"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-a17" value="取得・書込み・購読（同期）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-F_RP" target="p5-REF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-a18" value="変化通知（非同期）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#0050ef;fontColor=#0050ef;dashed=1;strokeWidth=2;exitX=0;exitY=0.15;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-REF" target="p5-FRAME"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-a19" value="MODEL=MiniPrinter&lt;br&gt;でビルド" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#9933ff;fontColor=#7a00cc;dashed=1;dashPattern=1 3;strokeWidth=2;endArrow=diamond;endFill=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.21;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-P_MP" target="p5-IFB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-a20" value="注入（起動時）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#9933ff;fontColor=#7a00cc;dashed=1;dashPattern=1 3;strokeWidth=2;endArrow=diamond;endFill=0;exitX=0.21;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-IFB" target="p5-F_INIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-a21" value="&lt;b&gt;ポイント&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;① 処理と定義を分ける&lt;/b&gt;&lt;br&gt;機種で変わらない「処理」（登録ループ、振り分け、エラー変換、排他）はFrameへ。機種で変わる「定義」（どのREF項目か、どの製品要求か、型の変換）は製品CFGへ。&lt;br&gt;&lt;br&gt;&lt;b&gt;② 製品CFGは表と変換関数だけ&lt;/b&gt;&lt;br&gt;PCL・REF・APIサーバーへの登録や送信はFrameが行う。製品CFGは純粋関数なので単体で試験できる。&lt;br&gt;&lt;br&gt;&lt;b&gt;③ 混入をビルドで防ぐ&lt;/b&gt;&lt;br&gt;FrameのCMakeには、REFの製品別ヘッダ（rim/include/&amp;lt;MODEL&amp;gt;）とAPIサーバーのヘッダのinclude pathを渡さない。Frameに機種依存コードを書くとビルドエラーになる。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fillColor=#ffffff;strokeColor=#333333;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="595" width="400" height="325" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6.フォルダ構成" id="p6"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6-a1" value="&lt;font style='font-size:18px'&gt;&lt;b&gt;フォルダ構成&lt;/b&gt;&lt;/font&gt;　フォルダを見れば「どれが機種依存か」が分かる構成" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p6-a2