<mxCell id="p3-REF" value="referenceServiceLayer（REF）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="800" width="280" height="200" as="geometry"/></mxCell><mxCell id="p3-RIM" value="&lt;b&gt;RIM（rim/include/&lt;font color='#cc0000'&gt;MiniPrinter&lt;/font&gt;/）&lt;/b&gt;&lt;br&gt;rim_proto.h：RIM_GetNetworkInfo / RIM_SetNetworkInfo / GetRIMFaultInfoList&lt;br&gt;rim_data_id.h：RI_DATA_*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="660" y="840" width="240" height="140" as="geometry"/></mxCell><mxCell id="p3-DEV" value="DEV / RSC" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="960" y="800" width="180" height="200" as="geometry"/></mxCell><mxCell id="p3-PDS" value="PrintDataStorage&lt;br&gt;PrintStorage&lt;br&gt;（Main buffer）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="975" y="840" width="150" height="140" as="geometry"/></mxCell><mxCell id="p3-a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-AS_REST" target="p3-REST_ADP"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="156" y="230"/><mxPoint x="50" y="230"/><mxPoint x="50" y="627"/></Array></mxGeometry></mxCell><mxCell id="p3-a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#000000;strokeWi