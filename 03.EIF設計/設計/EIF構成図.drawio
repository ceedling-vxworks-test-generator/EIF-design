          <mxGeometry x="2220" y="1550" width="240" height="26" as="geometry" />
        </mxCell>
        <mxCell id="nizJxYM3RZs7sc-WjUhk-66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#7C3AED;fontColor=#6D28D9;dashed=1;dashPattern=2 4;strokeWidth=2.5;endArrow=diamond;endFill=0;" edge="1" parent="1">
